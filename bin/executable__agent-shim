#!/usr/bin/env bash
# Internal dispatcher shared by the ~/bin/{claude,codex,opencode} shims.
# Each shim invokes us as:  _agent-shim <agent> "$@"
#
# Why this exists: shell-function wrappers (the old approach, defined in
# dot_zshrc) only work in interactive zsh. Any non-zsh shell, any script,
# any `exec()` syscall that resolves <agent> via PATH lookup would skip the
# wrapper and reach the real binary directly. By turning ~/bin/<agent> into
# a real on-disk script that PATH-shadows the real binary, we get
# system-level enforcement regardless of how the agent is invoked.
#
# The shim lifts known wrapper flags (--ssh / --gpg / --rbw / --agent-vault
# / --dotfiles / --gpu / --no-gpu) from "$@" so `claude --ssh` reaches agent-isolated correctly — its arg
# parser breaks out of flag parsing the moment it sees the agent name.
#
# Bypasses (intentional, for emergency use):
#   • AGENT_UNSANDBOX=1 claude …   — env-var gate inside agent-isolated
#   • ~/.local/bin/claude …        — invoke real binary by full path
# `command claude` does NOT bypass anymore — it still resolves through PATH
# and hits this shim. Before this change, `command claude` skipped the
# zsh function and reached the real binary; that hole is now closed.

set -euo pipefail

agent="$1"; shift

# Herdr identifies host-visible sandbox wrappers through this scoped hint. The
# actual agent process is hidden behind infisical + bwrap, so process-name
# detection cannot see it directly. Do not set this outside a Herdr pane.
if [[ "${HERDR_ENV:-}" == "1" ]]; then
    export HERDR_AGENT="$agent"
fi

wrapper_flags=()
passthrough=()
saw_terminator=0

for arg in "$@"; do
    if (( saw_terminator )); then
        passthrough+=("$arg")
        continue
    fi
    case "$arg" in
        --) saw_terminator=1; passthrough+=("$arg") ;;
        --ssh|--gpg|--rbw|--dotfiles|--gpu|--no-gpu \
        |--agent-vault|--no-agent-vault \
        |--docker|--no-docker \
        |--github|--no-github \
        |--plannotator|--no-plannotator)
            wrapper_flags+=("$arg") ;;
        *) passthrough+=("$arg") ;;
    esac
done

# Infisical injection layer (outermost) — DEFAULT-OFF since 2026-08-16.
#
# This used to run unconditionally, which handed every agent the real values
# of the per-agent API keys (ANTHROPIC_API_KEY, OPENROUTER_API_KEY,
# OPENCODE_API_KEY, EXA_API_KEY, …) in its environment. That is exactly what
# the credential broker exists to prevent, so it defeated the whole point:
# the bwrap masks hid the secret FILES while this line handed over the KEYS.
#
# Those keys are now brokered by agent-vault instead (default-on, see
# agent-isolated), so the agent reaches the same APIs without ever holding a
# token. Nothing here is needed for that path.
#
# Project runtime secrets (DATABASE_URL, JWT_SECRET — things an app reads and
# no HTTP proxy can broker) do NOT belong at this layer either: they are
# per-project, and injecting them globally scopes every agent to whatever
# .infisical.json happened to be in $PWD. Run those per-command inside the
# project instead:  infisical run -- npm test
# See ~/Programming/sift/.envrc for the pattern (coordinates in the file,
# token in $XDG_RUNTIME_DIR, zero secrets at rest).
#
# Escape hatch: AGENT_INFISICAL=1 restores the old always-inject behaviour
# for one invocation, e.g. debugging an agent that genuinely needs ambient
# project secrets. Layering when enabled: infisical run → agent-isolated →
# bwrap → agent; requires an interactive `infisical login`, or INFISICAL_TOKEN
# / INFISICAL_UNIVERSAL_AUTH_* exported for non-interactive callers.
infisical_prefix=()
if [[ "${AGENT_INFISICAL:-}" == "1" ]] && command -v infisical >/dev/null 2>&1; then
    infisical_prefix=(infisical run --silent --)
fi

exec "${infisical_prefix[@]}" "$HOME/bin/agent-isolated" "${wrapper_flags[@]}" "$agent" "${passthrough[@]}"
