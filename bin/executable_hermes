#!/usr/bin/env bash
# Hermes launcher shim for Zedra/phone terminals.
# Two layers, deliberately scoped:
#   infisical run  --path /env  → ONLY values hermes must hold itself: the Discord
#       gateway token (sent in a WebSocket IDENTIFY frame, so no proxy can broker
#       it) and the local allowlists it compares against. NOT the Hermes project
#       root — that path backs the agent-vault `hermes` vault, and injecting it
#       would hand hermes every credential the broker exists to hide.
#   agent-vault run --vault hermes → brokers Telegram / Home Assistant / Exa /
#       OpenRouter / OpenWebUI. Hermes never sees those values.
# Was --path /litellm: hermes references LITELLM_MASTER_KEY, LLM_GATEWAY_URL and
# DATABASE_URL exactly zero times, so that leg injected secrets it never used.
set -euo pipefail

REAL_HERMES="/home/nullsense/.local/bin/hermes"
INFISICAL_BIN="/usr/bin/infisical"
HERMES_PROJECT_ID="fa008956-fe73-494c-b0eb-3a71ea12820c"
AGENT_VAULT_BIN="/usr/local/bin/agent-vault"

# Avoid recursion/nesting if a child process calls hermes again from inside this wrapper.
if [[ "${HERMES_ZEDRA_WRAPPED:-}" == "1" ]]; then
  exec "$REAL_HERMES" "$@"
fi

export HERMES_ZEDRA_WRAPPED=1

if [[ -x "$INFISICAL_BIN" && -x "$AGENT_VAULT_BIN" ]]; then
  exec "$INFISICAL_BIN" run --projectId "$HERMES_PROJECT_ID" --env dev --path /env -- \
    "$AGENT_VAULT_BIN" run --vault hermes -- \
    "$REAL_HERMES" "$@"
elif [[ -x "$INFISICAL_BIN" ]]; then
  exec "$INFISICAL_BIN" run --projectId "$HERMES_PROJECT_ID" --env dev --path /env -- "$REAL_HERMES" "$@"
elif [[ -x "$AGENT_VAULT_BIN" ]]; then
  exec "$AGENT_VAULT_BIN" run --vault hermes -- "$REAL_HERMES" "$@"
else
  exec "$REAL_HERMES" "$@"
fi
