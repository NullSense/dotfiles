#!/usr/bin/env bash
# hermes-secret-set — set a secret in the Hermes Infisical project, safely.
#
# Prompts for the value instead of taking it as an argument, so it never lands
# in shell history, never appears in `ps`, and never has to be pasted into a
# chat window. Strips accidental surrounding <angle brackets> and quotes — the
# single most common paste mistake — then syncs the hermes vault.
#
# Usage:
#   hermes-secret-set TELEGRAM_BOT_TOKEN
#   hermes-secret-set DISCORD_BOT_TOKEN
#   hermes-secret-set --show DISCORD_ALLOWED_USERS   # echo input (non-secret)

set -euo pipefail
umask 077

readonly PROJECT_ID="${HERMES_INFISICAL_PROJECT_ID:-fa008956-fe73-494c-b0eb-3a71ea12820c}"
readonly INF_ENV="${HERMES_INFISICAL_ENV:-dev}"
readonly INF_PATH="${HERMES_INFISICAL_PATH:-/}"
readonly VAULT="${HERMES_VAULT:-hermes}"

SHOW=0
[[ "${1:-}" == "--show" ]] && { SHOW=1; shift; }
KEY="${1:-}"

if [[ -z "$KEY" ]]; then
    echo "usage: hermes-secret-set [--show] <KEY>" >&2
    exit 1
fi
if ! [[ "$KEY" =~ ^[A-Z][A-Z0-9_]*$ ]]; then
    echo "ERROR: '$KEY' must be UPPER_SNAKE_CASE — Agent Vault rejects anything else," >&2
    echo "       and one bad key fails the ENTIRE vault sync, not just that entry." >&2
    exit 1
fi

printf 'Value for %s: ' "$KEY" >&2
if (( SHOW )); then read -r VALUE; else read -rs VALUE; echo >&2; fi

# Strip the classic paste mistakes: wrapping <>, matching quotes, stray spaces.
VALUE="${VALUE#"${VALUE%%[![:space:]]*}"}"
VALUE="${VALUE%"${VALUE##*[![:space:]]}"}"
if [[ "$VALUE" == "<"*">" ]]; then
    VALUE="${VALUE#<}"; VALUE="${VALUE%>}"
    echo "  note: stripped surrounding <angle brackets>" >&2
fi
if [[ ( "$VALUE" == '"'*'"' ) || ( "$VALUE" == "'"*"'" ) ]]; then
    VALUE="${VALUE:1:${#VALUE}-2}"
    echo "  note: stripped surrounding quotes" >&2
fi
[[ -n "$VALUE" ]] || { echo "ERROR: empty value" >&2; exit 1; }

# Shape warnings for the formats that have bitten us. Advisory, not fatal.
case "$KEY" in
    TELEGRAM_BOT_TOKEN)
        [[ "$VALUE" =~ ^[0-9]+:[A-Za-z0-9_-]{30,}$ ]] \
            || echo "  WARNING: does not look like <botid>:<secret> — Telegram will 404" >&2 ;;
    DISCORD_BOT_TOKEN)
        [[ "$VALUE" == *.*.* ]] \
            || echo "  WARNING: Discord tokens normally have two dots" >&2 ;;
esac

D="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/hermes-secret.XXXXXX")"
F="$D/s.env"
trap 'shred -u "$F" 2>/dev/null || rm -f "$F"; rmdir "$D" 2>/dev/null || true' EXIT INT TERM
printf '%s="%s"\n' "$KEY" "${VALUE//\"/\\\"}" > "$F"
chmod 600 "$F"

infisical secrets set --file "$F" \
    --projectId "$PROJECT_ID" --env "$INF_ENV" --path "$INF_PATH" --silent \
    || { echo "ERROR: could not write to Infisical" >&2; exit 1; }
echo "  set $KEY in Infisical (${#VALUE} chars)" >&2

AGENT_VAULT_ADDR="${AGENT_VAULT_ADDR:-http://127.0.0.1:14321}" \
    agent-vault vault credential-store sync "$VAULT" >/dev/null 2>&1 \
    && echo "  synced vault '$VAULT'" >&2 \
    || echo "  note: vault sync failed; it will pick this up within 60s anyway" >&2
