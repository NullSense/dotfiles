#!/usr/bin/env bash
# hermes-vault-migrate — give the `hermes` Agent Vault vault its own credentials,
# backed by Infisical, and point the hermes launcher at it.
#
# WHY TWO VAULTS (do not merge them):
#   default → builtin store  → claude/codex/opencode. Builtin is the ONLY store
#                              where `agent-vault vault proposal create` accepts
#                              credential blocks, i.e. where an agent can ask you
#                              for a new key and you approve it in the browser.
#                              An Infisical-backed vault rejects those (409).
#   hermes  → infisical store → hermes. Fixed toolset, never needs to request a
#                              new credential, so it loses nothing and gains
#                              rotation / versioning / audit from Infisical.
#   Merging also hands hermes — which ingests untrusted Telegram messages —
#   GITHUB_TOKEN, VERCEL_TOKEN and HF_TOKEN. Don't.
#
# WHAT THIS DOES (idempotent — safe to re-run):
#   1. Preflight: binaries, broker reachable, Infisical login, vault exists.
#   2. Back up the Agent Vault DB and ~/bin/hermes.
#   3. Copy the hermes-relevant credentials out of `default` into the Infisical
#      Hermes project. Values go via a 0600 file on tmpfs, never argv, never
#      shell history, never disk outside $XDG_RUNTIME_DIR. Shredded on exit.
#   4. Connect the `hermes` vault to that Infisical project (read-only sync).
#   5. Create the hermes services (these are NEVER synced from Infisical —
#      service definitions always live in Agent Vault).
#   6. Point ~/bin/hermes at --vault hermes.
#   7. Verify and print a summary.
#
# USAGE:
#   hermes-vault-migrate --project-id <INFISICAL_PROJECT_ID> [--env dev] [--path /]
#   hermes-vault-migrate --project-id <ID> --dry-run     # show, change nothing
#
# Find the project ID in the Infisical dashboard: Project Settings → Project ID,
# or read it out of the dashboard URL.

set -euo pipefail
umask 077

readonly VAULT_SRC="default"
readonly VAULT_DST="hermes"
readonly AV_ADDR="${AGENT_VAULT_ADDR:-http://127.0.0.1:14321}"
readonly HERMES_LAUNCHER="$HOME/bin/hermes"
readonly STAMP="$(date +%Y%m%d-%H%M%S)"

# Credentials hermes actually needs. Deliberately EXCLUDES GITHUB_TOKEN,
# VERCEL_TOKEN, HF_TOKEN, CONTEXT7_API_KEY, EXA_API_KEY, FIRECRAWL_API_KEY,
# OPENCODE_API_KEY — hermes has no business with those.
readonly -a KEYS=(
    HASS_TOKEN
    HASS_URL
    TELEGRAM_BOT_TOKEN
    TELEGRAM_ALLOWED_USERS
    TELEGRAM_HOME_CHANNEL
    HERMES_SPOTIFY_CLIENT_ID
    OPENROUTER_API_KEY
    LITELLM_MCP_KEY
    OWUI_API_KEY
)

PROJECT_ID=""
INF_ENV="dev"
INF_PATH="/"
DRY_RUN=0

# ── plumbing ────────────────────────────────────────────────────────────────
c_ok=$'\033[32m'; c_warn=$'\033[33m'; c_err=$'\033[31m'; c_dim=$'\033[2m'; c_off=$'\033[0m'
[[ -t 1 ]] || { c_ok=""; c_warn=""; c_err=""; c_dim=""; c_off=""; }

step() { printf '\n%s==>%s %s\n' "$c_ok" "$c_off" "$*"; }
info() { printf '    %s\n' "$*"; }
warn() { printf '    %s! %s%s\n' "$c_warn" "$*" "$c_off"; }
die()  { printf '\n%sERROR:%s %s\n' "$c_err" "$c_off" "$*" >&2; exit 1; }
run()  {
    if (( DRY_RUN )); then printf '    %s[dry-run] %s%s\n' "$c_dim" "$*" "$c_off"; return 0; fi
    "$@"
}

usage() { sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; $d'; exit "${1:-0}"; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --project-id) PROJECT_ID="${2:?--project-id needs a value}"; shift 2 ;;
        --env)        INF_ENV="${2:?--env needs a value}";            shift 2 ;;
        --path)       INF_PATH="${2:?--path needs a value}";          shift 2 ;;
        --dry-run)    DRY_RUN=1; shift ;;
        -h|--help)    usage 0 ;;
        *)            die "unknown argument: $1 (try --help)" ;;
    esac
done

[[ -n "$PROJECT_ID" ]] || die "--project-id is required. Infisical dashboard → Project Settings → Project ID."

export AGENT_VAULT_ADDR="$AV_ADDR"

# Secrets staging file lives on tmpfs, 0600, shredded on any exit path.
STAGE=""
cleanup() {
    [[ -n "$STAGE" && -f "$STAGE" ]] || return 0
    command -v shred >/dev/null 2>&1 && shred -u "$STAGE" 2>/dev/null || rm -f "$STAGE"
}
trap cleanup EXIT INT TERM

# ── 1. preflight ────────────────────────────────────────────────────────────
step "Preflight"
for b in agent-vault infisical curl; do
    command -v "$b" >/dev/null 2>&1 || die "missing required binary: $b"
done
info "binaries present"

curl -fsS --max-time 5 "$AV_ADDR/health" >/dev/null 2>&1 \
    || die "Agent Vault not reachable at $AV_ADDR (systemctl --user status agent-vault.service)"
info "broker reachable at $AV_ADDR"

agent-vault vault list >/dev/null 2>&1 \
    || die "not authenticated to Agent Vault — run: agent-vault auth login"
agent-vault vault list 2>/dev/null | grep -q "$VAULT_DST" \
    || die "vault '$VAULT_DST' does not exist — create it: agent-vault vault create $VAULT_DST"
info "vaults '$VAULT_SRC' and '$VAULT_DST' present"

if grep -q 'loggedInUserEmail' "$HOME/.infisical/infisical-config.json" 2>/dev/null; then
    info "Infisical CLI is logged in"
else
    warn "Infisical CLI does not look logged in — run: infisical login"
fi

current_store="$(agent-vault vault credential-store show "$VAULT_DST" 2>/dev/null \
                 | sed -n 's/^Credential store:[[:space:]]*//p')"
info "'$VAULT_DST' credential store is currently: ${current_store:-unknown}"

# The broker itself must have an Infisical machine identity, or step 4 fails.
# Check now rather than after we have already written secrets upstream.
_probe_tok="$(agent-vault vault token --vault "$VAULT_SRC" 2>/dev/null || true)"
if [[ -n "$_probe_tok" ]] \
   && curl -fsS --max-time 5 -H "Authorization: Bearer $_probe_tok" \
        "$AV_ADDR/v1/vaults/$VAULT_SRC/settings" 2>/dev/null \
        | grep -q '"infisical_available":[[:space:]]*true'; then
    info "broker has an Infisical machine identity (infisical_available=true)"
else
    cat >&2 <<'MSG'

ERROR: the Agent Vault broker has no Infisical machine identity, so it cannot
       connect a vault to Infisical (infisical_available=false).

  This is an instance-level, one-time setup. Until it is done, step 4 fails.

  1. Infisical → Organization → Access Control → Identities → Create identity
     Name it e.g. agent-vault-broker, auth method Universal Auth.
     Save the Client ID and Client Secret.
  2. Grant it READ-ONLY access to the Hermes project
     (Project → Access Control → Identities → add, Viewer role).
  3. Seal both halves, then add them to the broker's unit:
       read -rs ID;     printf '%s' "$ID"     | systemd-creds encrypt --user \
           --with-key=tpm2+host --name=infisical-client-id - \
           ~/.config/credstore.encrypted/infisical-client-id.cred
       read -rs SECRET; printf '%s' "$SECRET" | systemd-creds encrypt --user \
           --with-key=tpm2+host --name=infisical-client-secret - \
           ~/.config/credstore.encrypted/infisical-client-secret.cred
       unset ID SECRET
     then systemctl --user daemon-reload && \
          systemctl --user restart agent-vault.service
  4. Re-run this script. It is idempotent — already-pushed secrets are skipped.

MSG
    die "broker not Infisical-enabled; see the steps above"
fi
unset _probe_tok

# ── 2. backups ──────────────────────────────────────────────────────────────
step "Backups"
if [[ -f "$HOME/.agent-vault/agent-vault.db" ]]; then
    run cp -a "$HOME/.agent-vault/agent-vault.db" \
              "$HOME/.agent-vault/agent-vault.db.bak-hermesmigrate-$STAMP"
    info "agent-vault.db → agent-vault.db.bak-hermesmigrate-$STAMP"
fi
if [[ -f "$HERMES_LAUNCHER" ]]; then
    run cp -a "$HERMES_LAUNCHER" "$HERMES_LAUNCHER.bak-hermesmigrate-$STAMP"
    info "$(basename "$HERMES_LAUNCHER") → $(basename "$HERMES_LAUNCHER").bak-hermesmigrate-$STAMP"
fi

# ── 3. copy credentials into Infisical ──────────────────────────────────────
step "Staging credentials for Infisical (project $PROJECT_ID, env $INF_ENV, path $INF_PATH)"

stage_dir="${XDG_RUNTIME_DIR:-/tmp}/hermes-vault-migrate.$$"
mkdir -p "$stage_dir"; chmod 700 "$stage_dir"
STAGE="$stage_dir/secrets.env"
: >"$STAGE"; chmod 600 "$STAGE"

found=0; missing=()
for k in "${KEYS[@]}"; do
    if v="$(agent-vault vault credential get "$k" --vault "$VAULT_SRC" 2>/dev/null)" && [[ -n "$v" ]]; then
        # Quote the value so newlines/spaces/# survive dotenv parsing.
        printf '%s="%s"\n' "$k" "${v//\"/\\\"}" >>"$STAGE"
        info "staged $k"
        found=$((found+1))
    else
        missing+=("$k")
    fi
done
(( found > 0 )) || die "no credentials could be read from vault '$VAULT_SRC'"
(( ${#missing[@]} == 0 )) || warn "not in '$VAULT_SRC', skipped: ${missing[*]}"
info "$found credential(s) staged in a 0600 tmpfs file (never argv, never history)"

if (( DRY_RUN )); then
    printf '    %s[dry-run] would push these keys: %s%s\n' "$c_dim" "$(cut -d= -f1 "$STAGE" | tr '\n' ' ')" "$c_off"
else
    infisical secrets set --file "$STAGE" \
        --projectId "$PROJECT_ID" --env "$INF_ENV" --path "$INF_PATH" --silent \
        || die "failed to write secrets to Infisical — check the project ID, env slug and path, and that your identity may create secrets there"
    info "pushed $found secret(s) to Infisical"
fi

cleanup; STAGE=""
rmdir "$stage_dir" 2>/dev/null || true

# ── 4. connect the vault to Infisical ───────────────────────────────────────
step "Connecting vault '$VAULT_DST' to Infisical"
if [[ "$current_store" == "infisical" ]]; then
    info "already infisical-backed; re-applying config to refresh cadence/scope"
fi
warn "this OVERWRITES any built-in credentials in '$VAULT_DST' with the Infisical snapshot"
run agent-vault vault credential-store set "$VAULT_DST" \
        --kind=infisical \
        --infisical-project-id="$PROJECT_ID" \
        --infisical-environment="$INF_ENV" \
        --infisical-path="$INF_PATH" \
        --poll-interval-seconds=60 \
        --yes \
    || die "credential-store set failed. It probes Infisical before committing, so the vault is unchanged. Check the project/env/path resolve and that the broker's machine identity can read them."

# ── 5. services (never synced from Infisical) ───────────────────────────────
step "Creating services in '$VAULT_DST'"
info "service definitions always live in Agent Vault — Infisical supplies values only"

svc_add() {
    local name="$1" host="$2" tokenkey="$3"
    if (( DRY_RUN )); then
        printf '    %s[dry-run] would add service %s → %s (bearer %s)%s\n' \
            "$c_dim" "$name" "$host" "$tokenkey" "$c_off"
        return 0
    fi
    agent-vault vault service add --vault "$VAULT_DST" \
        --name "$name" --host "$host" --auth-type bearer --token-key "$tokenkey" \
        >/dev/null && info "service $name → $host"
}
svc_add home-assistant "ha.tailb921b9.ts.net"                    HASS_TOKEN
svc_add openrouter     "openrouter.ai"                           OPENROUTER_API_KEY
svc_add openwebui      "nullsense-arch.tailb921b9.ts.net/api/*"  OWUI_API_KEY

# Telegram puts the bot token in the URL PATH, so it needs a substitution rule.
# Substitutions have no flag form — file mode only.
if (( DRY_RUN )); then
    printf '    %s[dry-run] would add telegram-bot with a path substitution%s\n' "$c_dim" "$c_off"
else
    agent-vault vault service add --vault "$VAULT_DST" -f - >/dev/null <<'YAML' \
        && info "service telegram-bot → api.telegram.org (path substitution)"
services:
  - name: telegram-bot
    host: api.telegram.org
    enabled: true
    auth:
      type: passthrough
    substitutions:
      - key: TELEGRAM_BOT_TOKEN
        placeholder: __telegram_bot_token__
        in: [path]
YAML
fi

# ── 6. point the launcher at the hermes vault ───────────────────────────────
step "Pointing $HERMES_LAUNCHER at --vault $VAULT_DST"
if [[ ! -f "$HERMES_LAUNCHER" ]]; then
    warn "$HERMES_LAUNCHER not found; skipping"
elif grep -q -- "--vault $VAULT_DST" "$HERMES_LAUNCHER"; then
    info "already points at '$VAULT_DST'"
else
    run sed -i "s/--vault $VAULT_SRC/--vault $VAULT_DST/g" "$HERMES_LAUNCHER"
    info "rewritten"
fi

# ── 7. verify ───────────────────────────────────────────────────────────────
step "Verification"
if (( DRY_RUN )); then
    info "dry-run: nothing changed, nothing to verify"
else
    echo
    agent-vault vault credential-store show "$VAULT_DST" 2>&1 | sed 's/^/    /'
    echo
    agent-vault vault credential list --vault "$VAULT_DST" 2>&1 | sed 's/^/    /'
    echo
    agent-vault vault service list --vault "$VAULT_DST" 2>&1 | sed 's/^/    /'
fi

cat <<EOF

$(printf '%s' "$c_ok")Done.$(printf '%s' "$c_off")

Still yours to do:
  • hermes still reads real values from ~/.hermes/.env — brokering only takes
    effect once those are blanked or placeholdered. Do Telegram LAST: its token
    is <botid>:<secret> in the URL path, and an Agent Vault placeholder cannot
    contain ':', so set TELEGRAM_BOT_TOKEN=<real_bot_id>:__telegram_bot_token__
    and store ONLY the secret half in Infisical.
  • ~/bin/hermes is not chezmoi-managed — consider: chezmoi add ~/bin/hermes
  • Rotate any secret in Infisical and the vault picks it up within 60s;
    force it now with: agent-vault vault credential-store sync $VAULT_DST

Rollback:
  agent-vault vault credential-store set $VAULT_DST --kind=builtin --yes
  cp -a $HERMES_LAUNCHER.bak-hermesmigrate-$STAMP $HERMES_LAUNCHER

If you ever really want ONE vault (you lose credential proposals on the
coding agents — see the header):
  agent-vault vault credential-store set $VAULT_SRC --kind=infisical \\
      --infisical-project-id=$PROJECT_ID --infisical-environment=$INF_ENV \\
      --infisical-path=$INF_PATH --yes
EOF
