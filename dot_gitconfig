[user]
    email = matas234@gmail.com
    name = NullSense
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJK+IxBkjVonY3gehBXpbtqCvZINMlc5LlfNNIoLwddp git signing key

[init]
    defaultBranch = main
	templateDir = /home/nullsense/.git-template

[core]
    excludesfile = ~/.gitignore
    pager = delta --dark
    fsmonitor = true
    untrackedCache = true
    autocrlf = input

[credential]
    helper = store

[interactive]
    diffFilter = delta --color-only

[delta]
    features = line-numbers decorations
    syntax-theme = gruvbox-dark
    navigate = true
    line-numbers = true
    side-by-side = false

[delta "decorations"]
    file-style = bold blue ul

[diff]
    algorithm = histogram
    colorMoved = default
    renames = copies

[merge]
    conflictStyle = zdiff3
    autoStash = true

[rebase]
    autosquash = true
    autoStash = true
    updateRefs = true

[pull]
    rebase = true

[push]
    autoSetupRemote = true
    default = simple
    followTags = true

[fetch]
    prune = true
    pruneTags = true
    parallel = 0

[rerere]
    enabled = true
    autoUpdate = true

[branch]
    sort = -committerdate

[tag]
    sort = version:refname
    gpgSign = true

[column]
    ui = auto

[commit]
    verbose = true
    gpgSign = true

[log]
    date = iso
    decorate = full

[help]
    autocorrect = prompt

[advice]
    detachedHead = false
    skippedCherryPicks = false

[filter "lfs"]
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = /home/nullsense/.config/git/allowed_signers
    program = /home/nullsense/bin/git-sign-ssh
# Route ALL GitHub git operations (fetch AND push) over https with the gh
# OAuth token, via the credential helper below.
#
# 2026-07-27: this REPLACES the previous "everything over SSH" rewrite. That
# rewrite existed because git-over-https once relied on agent-vault token
# injection, which only covers api.github.com, so `git push` from a sandboxed
# agent 401'd. That rationale is obsolete: the `!gh auth git-credential`
# helper supplies the token directly rather than depending on proxy injection,
# verified from inside agent-isolated against private repos (fetch + push).
#
# Why the change: the SSH path authenticates through the Bitwarden SSH agent,
# which is a Desktop-GUI-only feature. From a remote SSH session (e.g. phone
# while travelling) its per-session confirmation prompt renders on the
# unattended desktop, so git hangs forever rather than failing. The gh token
# is plaintext in ~/.config/gh/hosts.yml (NOT the keyring), so https works
# headless: no GUI, no keyring unlock, no agent.
#
# The `NullSense@` userinfo is load-bearing — it is what the credential helper
# keys on, and it keeps the URL from matching a bare https://github.com/ base.
# Org repos are fine: only the prefix is swapped, so Cortiq-Lab/… is preserved.
#
# Revert to SSH-for-everything:
#   git config --global --remove-section 'url.https://NullSense@github.com/'
#   git config --global url."git@github.com:".insteadOf https://github.com/
[url "https://NullSense@github.com/"]
    insteadOf = git@github.com:
    insteadOf = ssh://git@github.com/
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
