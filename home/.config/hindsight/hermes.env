# Non-secret runtime configuration for the systemd-owned Hermes memory API.
# The LiteLLM key is decrypted directly into the service environment by the
# unit and must never be stored here.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=qwen3.8-27b-nvfp4-long:fast
HINDSIGHT_API_LLM_BASE_URL=http://127.0.0.1:4000/v1
HINDSIGHT_API_LLM_DEFAULT_HEADERS='{"x-litellm-tags":"client:hermes,role:hindsight"}'
HINDSIGHT_API_DATABASE_URL=pg0://hindsight-embed-hermes
HINDSIGHT_API_LOG_LEVEL=info
HINDSIGHT_EMBED_DAEMON_IDLE_TIMEOUT=0
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_EMBEDDINGS_DEVICE=cpu
HINDSIGHT_API_RERANKER_DEVICE=cpu
ONNXRUNTIME_PROVIDER=CPUExecutionProvider
CUDA_VISIBLE_DEVICES=
NVIDIA_VISIBLE_DEVICES=none
TOKENIZERS_PARALLELISM=false
HINDSIGHT_API_CONSOLIDATION_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_CONSOLIDATION_LLM_PARALLELISM=1
HINDSIGHT_API_CONSOLIDATION_MAX_MEMORIES_PER_ROUND=50
# Keep one reflection inside the local scheduling reserve. The measured peak
# was 35,050 prompt tokens; 50K leaves conservative variance without allowing
# the upstream 100K default to consume another full Hermes worker slot.
HINDSIGHT_API_REFLECT_MAX_CONTEXT_TOKENS=50000
HINDSIGHT_API_RETAIN_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_RETAIN_ENTITY_RESOLUTION_BATCH_SIZE=250
