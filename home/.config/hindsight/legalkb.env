# LegalKB agent memory only. Never point this runtime at the Hermes database.
HINDSIGHT_API_DATABASE_URL=pg0://hindsight-legalkb
# Primary: OpenCode Go (key: systemd credential opencode-go-key, loaded by service.py).
# Go rejects requests without a session header and wants a non-generic User-Agent.
HINDSIGHT_API_LLM_PROVIDER=opencode-go
HINDSIGHT_API_LLM_MODEL=deepseek-v4.1-flash
HINDSIGHT_API_LLM_DEFAULT_HEADERS='{"x-opencode-session":"hindsight-legalkb","User-Agent":"hindsight-legalkb/0.9.1"}'
# Failover: Claude subscription via the CLI; CLAUDE_CODE_EFFORT_LEVEL below keeps it at low effort.
HINDSIGHT_API_LLM_STRATEGY='{"mode":"failover"}'
HINDSIGHT_API_LLM_1_PROVIDER=claude-code
HINDSIGHT_API_LLM_1_MODEL=claude-opus-5-5
HINDSIGHT_API_LLM_MAX_RETRIES=1
HINDSIGHT_API_EMBEDDINGS_PROVIDER=litellm
HINDSIGHT_API_EMBEDDINGS_LITELLM_API_BASE=http://127.0.0.1:4000
HINDSIGHT_API_EMBEDDINGS_LITELLM_MODEL=embed-nemotron
HINDSIGHT_API_RERANKER_PROVIDER=litellm
HINDSIGHT_API_RERANKER_LITELLM_API_BASE=http://127.0.0.1:4000
HINDSIGHT_API_RERANKER_LITELLM_MODEL=rerank-nemotron
HINDSIGHT_API_RERANKER_LITELLM_TIMEOUT=330
HINDSIGHT_API_RETAIN_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_CONSOLIDATION_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_CONSOLIDATION_LLM_PARALLELISM=1
HINDSIGHT_API_REFLECT_MAX_CONTEXT_TOKENS=16000
HINDSIGHT_API_STORE_DOCUMENT_TEXT=true
HINDSIGHT_API_ENABLE_OBSERVATIONS=true
HINDSIGHT_API_LOG_LEVEL=info
TOKENIZERS_PARALLELISM=false
HINDSIGHT_API_DB_POOL_MIN_SIZE=2
HINDSIGHT_API_DB_POOL_MAX_SIZE=10
HINDSIGHT_API_WORKER_MAX_SLOTS=3
HINDSIGHT_API_REFLECT_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_REFLECT_WALL_TIMEOUT=600
HINDSIGHT_API_WORKER_CONSOLIDATION_RESERVED_SLOTS=1
HINDSIGHT_API_MCP_EXTENSION=mcp_extension:KnowledgeSearchExtension
CLAUDE_CODE_EFFORT_LEVEL=low
# LLM request tracing (llm_requests table) stores full prompts, which can name the case-bank subject.
# Hindsight 0.9.1 can only scope tracing by call scope (retain/reflect/...), not by bank, so no
# dev-bank-only trace is possible. ENABLED stays true only so the built-in retention sweep keeps
# purging old rows (it is skipped when ENABLED=false); the scope allowlist matches no real call scope,
# so nothing new is recorded for any bank. See pipeline/hindsight_runtime/README.md.
HINDSIGHT_API_LLM_TRACE_ENABLED=true
HINDSIGHT_API_LLM_TRACE_SCOPES=__record_nothing__
HINDSIGHT_API_LLM_TRACE_RETENTION_DAYS=1
