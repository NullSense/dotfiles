{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "litellm": {
      "type": "remote",
      "url": "http://127.0.0.1:4001/mcp/",
      "enabled": true
    }
  },
  "permission": {
    "litellm_hindsight_*": "deny"
  },
  "plugin": [
    "@tarquinen/opencode-dcp@3.1.15",
    "cc-safety-net@2.0.6"
  ]
}
