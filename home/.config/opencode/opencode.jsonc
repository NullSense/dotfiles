{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/local-model-rules.md"
  ],
  "provider": {
    "llama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (Qwen3.6-35B-A3B APEX-MTP local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "sk-local"
      },
      "models": {
        "qwen3.6-35b-a3b-apex": {
          "name": "Qwen3.6 35B-A3B APEX-MTP (local)",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        }
      }
    }
  },
  "mcp": {
    "litellm": {
      "type": "remote",
      "url": "http://127.0.0.1:4001/mcp/",
      "enabled": true
    }
  },
  "permission": {
    "litellm_hindsight_*": "deny"
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "cc-safety-net"
  ]
}
