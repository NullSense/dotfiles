[Unit]
Description=Weekly Helium AppImage update check

[Timer]
# A calendar timer always has a next activation after a user-manager restart.
# The previous monotonic OnBootSec + OnUnitActiveSec combination could become
# active (elapsed) with Next=infinity after login/session recovery.
OnCalendar=Mon *-*-* 09:00:00
Persistent=true
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
