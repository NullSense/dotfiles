[Unit]
Description=Hindsight memory API and web UI for Hermes
After=network-online.target litellm.service
Wants=network-online.target litellm.service
Before=hermes-gateway.service

[Service]
Type=oneshot
RemainAfterExit=yes
LoadCredentialEncrypted=hermes-litellm-key:%h/.config/credstore.encrypted/hermes-litellm-key.cred
ExecStart=/usr/bin/bash -c 'export HINDSIGHT_API_LLM_API_KEY="$(<"%d/hermes-litellm-key")"; exec /home/nullsense/.hermes/hermes-agent/venv/bin/hindsight-embed -p hermes daemon start'
ExecStart=/home/nullsense/.hermes/hermes-agent/venv/bin/hindsight-embed -p hermes ui start --hostname 127.0.0.1 --port 19177
ExecStop=/home/nullsense/.hermes/hermes-agent/venv/bin/hindsight-embed -p hermes ui stop --port 19177
ExecStop=/home/nullsense/.hermes/hermes-agent/venv/bin/hindsight-embed -p hermes daemon stop
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=default.target
