[Unit]
Description=Hindsight memory for LegalKB development and private cases
After=litellm.service
Wants=litellm.service

[Service]
Type=exec
WorkingDirectory=%h/Documents/pipeline/hindsight_runtime
EnvironmentFile=%h/.config/hindsight/legalkb.env
# Reuse the existing gateway credential read-only; do not alter Hermes.
LoadCredentialEncrypted=hermes-litellm-key:%h/.config/credstore.encrypted/hermes-litellm-key.cred
ExecStart=%h/Documents/pipeline/hindsight_runtime/.venv/bin/uvicorn service:app --host 127.0.0.1 --port 9178 --workers 1 --no-access-log
Restart=on-failure
RestartSec=30
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=default.target
