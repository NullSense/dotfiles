[Unit]
Description=Hindsight memory for LegalKB development and private cases
After=litellm.service
Wants=litellm.service

[Service]
Type=exec
RuntimeDirectory=hindsight-legalkb
RuntimeDirectoryMode=0700
WorkingDirectory=%t/hindsight-legalkb
EnvironmentFile=%h/.config/hindsight/legalkb.env
Environment=PYTHONPATH=%h/Documents/pipeline
# Reuse the existing gateway credential read-only; do not alter Hermes.
LoadCredentialEncrypted=hermes-litellm-key:%h/.config/credstore.encrypted/hermes-litellm-key.cred
# OpenCode Go key for the primary LLM; service.py exports it to that provider only.
LoadCredentialEncrypted=opencode-go-key:%h/.config/credstore.encrypted/opencode-go-key.cred
ExecStart=%h/Documents/pipeline/hindsight_runtime/.venv/bin/uvicorn service:app --app-dir %h/Documents/pipeline/hindsight_runtime --host 127.0.0.1 --port 9178 --workers 1 --no-access-log
Restart=on-failure
RestartSec=30
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=default.target
