[Unit]
Description=LegalKB warm retrieval server :8077
Documentation=file:///home/nullsense/Documents/pipeline/legalkb/docs/2026-09-08-latency-profile-and-warmup.md
# llama-swap serves the embedder this depends on for /search. It is Wants= rather
# than Requires= on purpose: /show, /related and /navigate are pure SQLite and stay
# useful with no GPU at all, so legalkb must not refuse to start when the router is down.
After=llama-swap.service
Wants=llama-swap.service
# Launch-time upstream check (probe only, its own process and failure domain; no After=, so serving
# never waits). legalkb/docs/2026-10-05-incremental-update-capability.md §4.3.
Wants=legalkb-update-check.service

[Service]
Type=simple
WorkingDirectory=/home/nullsense/Documents/pipeline
ExecStart=/usr/bin/uv run python -m legalkb serve

# Warm this PROCESS's caches, not the GPU. Measured 2026-09-08 under a concurrent
# backfill: first call 26.7 s on /health and 0.95 s on /show, then 0.0005 s and
# 0.0008 s warm — the cost is a per-process cold computation, paid once, so paying
# it here means the first real query never does. /health alone is most of it: it
# aggregates over 93,689 works and 206,350 edges.
# GPU model residency is owned by llama-swap, independently of this server.
# LegalKB stays on-demand; start with: systemctl --user start legalkb.service
ExecStartPost=/usr/bin/curl --fail --silent --output /dev/null --retry 120 --retry-delay 2 --retry-connrefused --retry-all-errors --connect-timeout 2 --max-time 120 http://127.0.0.1:8077/health
# `-` prefix: a warm-up is an optimisation, never a reason to declare the server down.
# The JSON must be single-quoted or systemd splits it on spaces and curl sends garbage.
ExecStartPost=-/usr/bin/curl --fail --silent --output /dev/null --max-time 60 -X POST http://127.0.0.1:8077/show -H 'Content-Type: application/json' -d '{"id":"de.sgb_2.§22","as_of":"today"}'

# uv reports a forwarded SIGTERM as exit 143 during a normal systemctl stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
# The warm-up above runs inside the start job, and a cold /health on a loaded box
# has been measured at 26.7 s.
TimeoutStartSec=300
TimeoutStopSec=20
Environment=PATH=/home/nullsense/bin:/home/nullsense/.local/bin:/home/nullsense/.local/share/mise/shims:/usr/local/bin:/usr/bin

[Install]
WantedBy=default.target
