[Unit]
Description=litellm MCP aggregation instance :4001
After=litellm.service hindsight-hermes.service
Wants=litellm.service hindsight-hermes.service

[Service]
LoadCredentialEncrypted=infisical-client-id:%h/.config/credstore.encrypted/litellm-infisical-client-id.cred
LoadCredentialEncrypted=infisical-client-secret:%h/.config/credstore.encrypted/litellm-infisical-client-secret.cred
Type=exec
ExecStart=/home/nullsense/bin/llm-servers/litellm-mcp
ExecStartPost=%h/bin/llm-servers/wait-ready http://127.0.0.1:4001/health/liveliness 570
Restart=on-failure
RestartSec=5
RestartSteps=4
RestartMaxDelaySec=60
KillMode=control-group
# MCP tool discovery can legitimately take minutes with slow remotes
TimeoutStartSec=600
TimeoutStopSec=20
Environment=PATH=/home/nullsense/bin:/home/nullsense/.local/bin:/home/nullsense/.local/share/mise/shims:/usr/local/bin:/usr/bin
WorkingDirectory=/home/nullsense

[Install]
WantedBy=default.target
