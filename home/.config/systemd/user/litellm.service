[Unit]
Description=litellm model gateway :4000 (MCP-free profile — fast boot, always on)
Requires=litellm-db.service
After=litellm-db.service

[Service]
LoadCredentialEncrypted=infisical-client-id:%h/.config/credstore.encrypted/litellm-infisical-client-id.cred
LoadCredentialEncrypted=infisical-client-secret:%h/.config/credstore.encrypted/litellm-infisical-client-secret.cred
Type=exec
ExecStart=/home/nullsense/bin/llm-servers/litellm-gateway
# ExecStartPost detects early process exit and waits for HTTP readiness. It
# participates in systemd ordering, so downstream After=litellm.service units
# wait for the real readiness endpoint.
ExecStartPost=%h/bin/llm-servers/wait-ready http://127.0.0.1:4000/health/liveliness 180
Restart=on-failure
RestartSec=3
RestartSteps=4
RestartMaxDelaySec=30
# never orphan: kill the whole cgroup (infisical wrapper + litellm + MCP children)
KillMode=control-group
TimeoutStartSec=200
TimeoutStopSec=20
Environment=PATH=/home/nullsense/bin:/home/nullsense/.local/bin:/home/nullsense/.local/share/mise/shims:/usr/local/bin:/usr/bin
# THE SWITCH lives here now (systemd can't inherit a caller's exports):
# `stack` writes LITELLM_ENVIRONMENT=development|production into this file.
EnvironmentFile=-%h/.config/litellm/gateway.env
WorkingDirectory=/home/nullsense

[Install]
WantedBy=default.target
