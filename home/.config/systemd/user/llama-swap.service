[Unit]
Description=llama-swap local OpenAI-compatible model router

[Service]
Type=simple
ExecStart=/usr/bin/llama-swap --config /home/nullsense/.config/llama-swap/config.yaml --listen 127.0.0.1:9292
Restart=on-failure
RestartSec=3
TimeoutStopSec=60
WorkingDirectory=/home/nullsense
Environment=PATH=/home/nullsense/.local/bin:/home/nullsense/.local/share/mise/shims:/usr/local/bin:/usr/bin

[Install]
WantedBy=default.target
