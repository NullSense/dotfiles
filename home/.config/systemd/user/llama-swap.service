[Unit]
Description=llama-swap local OpenAI-compatible model router

[Service]
Type=simple
ExecStart=/usr/bin/llama-swap --config /home/nullsense/.config/llama-swap/config.yaml --listen 127.0.0.1:9292
# always, not on-failure: llama-swap traps SIGTERM and exits 0, so an external kill
# (earlyoom, whose --prefer regex matches `llama`, did this at 2026-10-09 19:11:20 under
# host-RAM pressure) looked like a clean exit and the router stayed down. `systemctl stop`
# still stops it for good; only signals that bypass systemd now trigger a restart.
Restart=always
RestartSec=3
TimeoutStopSec=60
WorkingDirectory=/home/nullsense
Environment=PATH=/home/nullsense/.local/bin:/home/nullsense/.local/share/mise/shims:/usr/local/bin:/usr/bin

[Install]
WantedBy=default.target
