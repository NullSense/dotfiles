[Unit]
Description=Shared sccache daemon for local and agent builds

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=SCCACHE_IDLE_TIMEOUT=0
Environment=SCCACHE_CLIENT_SIDE=1
# Cache directory and size come only from ~/.config/sccache/config; an
# Environment= copy here would silently override it.
# Same binary cargo's rustc-wrapper execs (pacman's /usr/bin/sccache), so the
# server and its clients are always one version. An unmanaged ~/.local/bin copy
# ran here until 2026-10-08 and was left at 0.17.0 while pacman moved to 0.18.0.
ExecStart=/usr/bin/sccache --start-server
ExecStop=/usr/bin/sccache --stop-server

[Install]
WantedBy=default.target
