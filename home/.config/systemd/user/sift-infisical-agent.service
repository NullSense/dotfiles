[Unit]
Description=Infisical Agent — Sift dev token sink for keychainless coding agents
Documentation=file://%h/Programming/sift/SETUP.md
# Sift dev tasks (scripts/with-env.sh) authenticate coding agents with the
# short-lived token this Agent renews in /run/user/1000/sift-infisical/
# access-token (INFISICAL_TOKEN_FILE, set by the herdr `sift` layout).
#
# It used to be a transient `systemd-run` unit whose client secret was a
# one-time file under /run/user/1000, deleted after first read. That sink
# died at every reboot and whenever the token hit its max TTL, and nothing
# brought it back, so every agent worktree failed closed.
#
# Identity: `sift-local-dev` on infisical.cortiq-lab.sh, Terraform-managed in
# the infra repo (registry/apps/sift.yaml secrets.localDev): org and project
# role no-access plus read on dev:/sift-dev/** only.
#
# One-time setup (and on rotation), with a logged-in `cortiq` CLI profile:
# mint a client secret and seal both halves without printing them.
#   umask 077; B=https://infisical.cortiq-lab.sh/api
#   ID=<terraform -chdir=terraform/infisical output -json local_dev_identity_ids | jq -r .sift>
#   T="$(infisical user get token --plain --silent --profile cortiq)"
#   curl -fsS -H "Authorization: Bearer $T" "$B/v1/auth/universal-auth/identities/$ID" \
#     | jq -j .identityUniversalAuth.clientId | systemd-creds encrypt --user \
#       --name=sift-infisical-client-id - ~/.config/credstore.encrypted/sift-infisical-client-id.cred
#   curl -fsS -X POST -H "Authorization: Bearer $T" -H 'Content-Type: application/json' \
#     --data '{"description":"sift-infisical-agent.service","numUsesLimit":0,"ttl":0}' \
#     "$B/v1/auth/universal-auth/identities/$ID/client-secrets" | jq -je .clientSecret \
#     | systemd-creds encrypt --user --name=sift-infisical-client-secret - \
#       ~/.config/credstore.encrypted/sift-infisical-client-secret.cred; unset T
#   systemctl --user restart sift-infisical-agent.service
# Revoke the superseded client secret in the dashboard afterwards.

[Service]
Type=exec
UMask=0077
# Both halves stay TPM2-sealed at rest; systemd unseals them into the
# service-private $CREDENTIALS_DIRECTORY only while the Agent runs.
LoadCredentialEncrypted=sift-infisical-client-id:%h/.config/credstore.encrypted/sift-infisical-client-id.cred
LoadCredentialEncrypted=sift-infisical-client-secret:%h/.config/credstore.encrypted/sift-infisical-client-secret.cred
# Owns /run/user/1000/sift-infisical (mode 0700). Removed on stop, so a
# stopped Agent never leaves a stale token behind.
RuntimeDirectory=sift-infisical
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/infisical agent --config %h/.config/sift-infisical/agent.yaml
# The Cortiq instance is tailnet-only (100.98.70.22): when tailscaled comes up
# after this unit, the Agent's own retries plus Restart= cover the gap.
Restart=on-failure
RestartSec=5
RestartSteps=4
RestartMaxDelaySec=60

PrivateTmp=true
ProtectSystem=strict
# The CLI records its update check under ~/.infisical.
ReadWritePaths=%h/.infisical
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true

[Install]
WantedBy=default.target
