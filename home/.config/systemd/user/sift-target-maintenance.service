[Unit]
Description=Reap finished Sift worktrees and bound their Cargo targets
# bash runs the scripts, so they need not carry an executable bit; an
# executable-bit condition here silently skipped every run since it was added.
ConditionPathIsDirectory=%h/Programming/sift/.git
ConditionPathExists=%h/Programming/sift/scripts/target-maintenance.sh

[Service]
Type=oneshot
WorkingDirectory=%h/Programming/sift
# Policy lives in the repository; this unit is only the trigger. Worktree
# removal is fail-closed and keeps its refusals in the journal, so a kept
# worktree never stops the target bound that follows ('-' prefix).
ExecStart=-/usr/bin/bash %h/Programming/sift/scripts/worktree-lifecycle.sh reap
ExecStart=-/usr/bin/bash %h/Programming/sift/scripts/worktree-lifecycle.sh prune-cache
# Each checkout bounds its own (path-bound) target with its OWN script. One
# script run with --all-worktrees from the main checkout judged every target by
# whatever branch the main checkout had checked out: an older copy there refused
# targets the current rules accept, and the unit failed every hour while
# worktree targets sat over the cap (2026-10-16). Pre-commit snapshot worktrees
# have no target and are skipped by the script itself.
ExecStart=/usr/bin/bash -c 'status=0; while IFS= read -r tree; do [ -f "$$tree/scripts/target-maintenance.sh" ] || continue; (cd "$$tree" && bash scripts/target-maintenance.sh) || status=1; done < <(git -C %h/Programming/sift worktree list --porcelain | sed -n "s/^worktree //p"); exit "$$status"'

Nice=15
IOSchedulingClass=idle
