[Unit]
Description=Hourly bounded cleanup of Sift worktrees and Cargo targets

[Timer]
# Hourly: one local acceptance run can add 100+ GB of targets, and a run under
# the caps costs only a du per checkout at idle priority. Calendar (not
# monotonic) timers recover missed runs after downtime.
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
