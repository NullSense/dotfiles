[Unit]
Description=Check for a newer stable vLLM image
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Pulling a multi-gigabyte image, starting GPU canaries, and changing the shared
# pin are deliberate maintenance actions. The timer only reports availability.
ExecStart=%h/bin/vllm-update --notify
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/bin:/usr/bin
TimeoutStartSec=120
