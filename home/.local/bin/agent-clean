#!/usr/bin/env python3
"""agent-clean: the one sanctioned way for agents to delete what they created.

Claude Code denies `rm -rf` on absolute and home paths. This tool is allowlisted instead, and it
deletes only inside fixed roots, only things no running process is using:

  agent-clean path PATH...          a directory or file under an allowed root (never the root itself)
  agent-clean docker NAME...        a stopped test-stack or builder container (never volumes,
                                    never services); add --running for your own finished stack
  agent-clean docker --owner-root PATH NAME...
                                    any project's disposable audit/test/bench/build containers;
                                    verify ownership through binds into a private agent-tmp root;
                                    --network NAME also removes explicitly named, exclusively owned networks
  agent-clean network --owner-worktree PATH --owner-git-common-dir PATH ID_OR_NAME...
                                    preview empty, exactly owned Sift test networks; --execute removes
                                    only networks, preserving containers and volumes
  agent-clean --dry-run ...         show what would be removed

Allowed path roots: ~/.cache/agent-tmp/<x>, ~/.cache/claude-tmp/<x>, ~/.cache/sift-la/<x>
(local-acceptance stack data), and generated build/test output of a worktree under
~/Programming/.sift-worktrees/: a `target/` dir at the worktree root or in a nested cargo project
(e.g. `lints/target/`), and cargo-mutants' `mutants.out/` or `mutants.out.old/`. Those names are
gitignored and never tracked, so a containing source directory is still refused. Root-owned files
left by rootful Docker/BuildKit under an allowed path are removed through a throwaway alpine
container. Python bytecode files directly inside __pycache__ in ~/bin, ~/.local/bin and
their dotfile source directories are also allowed. Whole cache directories must
contain only owned regular .pyc/.pyo files; links and other contents are refused.
"""
import os
import argparse
import fcntl
import json
import re
import shutil
import stat
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
TMP_ROOTS = [HOME / ".cache/agent-tmp", HOME / ".cache/claude-tmp", HOME / ".cache/sift-la"]
WORKTREES = HOME / "Programming/.sift-worktrees"
# Generated, gitignored build/test output that a worktree may own: cargo's `target` (the workspace
# root, or a nested cargo project such as `lints/target/`) and cargo-mutants' run output. Tracked
# trees never use these names, and a containing directory is still refused below.
WORKTREE_OUTPUTS = frozenset({"target", "mutants.out", "mutants.out.old"})
BYTECODE_ROOTS = [HOME / "bin", HOME / ".local/bin", HOME / ".dotfiles/home/bin",
                  HOME / ".dotfiles/home/.local/bin"]
CONTAINER_OK = re.compile(
    r"^(sift-test-[0-9a-f]+-[a-z0-9-]+"
    r"|[a-z0-9][a-z0-9_.-]*-(postgres|qdrant)-test-1"
    r"|sift-la-[a-z0-9_.-]+"
    r"|sift-lifecycle-[a-z0-9_.-]+"
    r"|sift-[0-9a-f]{32}-acceptance-relay-(api|cp)"
    r"|buildx_buildkit_sift-[a-z0-9_.-]+"
    r"|buildx_buildkit_oracle-[a-z0-9_.-]+"
    r"|oracle-cache-[a-z0-9_.-]+-[0-9]{8})$"
)
# Agent-owned name prefixes exempt from CONTAINER_NEVER: oracle's agent build/acceptance containers
# carry a dated `oracle-cache-…-YYYYMMDD` name; its services (oracle-postgres-dev, …) don't.
CONTAINER_AGENT_OWNED = re.compile(r"^(oracle-cache-|buildx_buildkit_oracle-)")
CONTAINER_NEVER = re.compile(r"(oracle|infra|litellm|vllm|llama|hindsight|grafana|prometheus|loki|tempo)", re.I)


def fail(msg):
    print(f"agent-clean: {msg}", file=sys.stderr)
    sys.exit(2)


def allowed_bytecode(path):
    """Narrow exception for generated command caches, never arbitrary home files."""
    cache = path if path.name == "__pycache__" else path.parent
    if cache.name != "__pycache__" or cache.parent not in BYTECODE_ROOTS:
        return False
    if path.is_symlink():
        return False
    if not path.exists():
        return path == cache or path.suffix in (".pyc", ".pyo")
    if path == cache:
        info = path.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
            return False
        return all(allowed_bytecode(child) for child in path.iterdir())
    info = path.lstat()
    return (path.suffix in (".pyc", ".pyo") and stat.S_ISREG(info.st_mode)
            and info.st_uid == os.getuid())


def allowed_path(raw):
    p = Path(os.path.abspath(os.path.expanduser(raw)))
    # Resolve the parent, never the final component: a symlink is removed as a link and never
    # followed, and `..`/symlinked parents cannot escape the roots.
    real = Path(os.path.realpath(p.parent)) / p.name
    if any(root in real.parents for root in TMP_ROOTS):
        return real
    if WORKTREES in real.parents:
        rel = real.relative_to(WORKTREES)
        # rel.parts[0] is the worktree itself, so only a build-output directory named inside the
        # worktree's own path qualifies; the tracked directory containing it (`lints/`, `web/`) is
        # still refused.
        if len(rel.parts) >= 2 and WORKTREE_OUTPUTS & set(rel.parts[1:]):
            return real
    if allowed_bytecode(real):
        return real
    fail(f"refused: {raw} is outside the allowed roots or approved Python bytecode caches "
         "(agent-tmp, claude-tmp, worktree build output, command __pycache__)")


def users_of(path):
    prefix = str(path)
    hits = set()
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit() or int(proc.name) == os.getpid():
            continue
        try:
            links = [proc / "cwd", proc / "root"] + list((proc / "fd").iterdir())
        except OSError:
            continue
        for link in links:
            try:
                target = os.readlink(link)
            except OSError:
                continue
            if target == prefix or target.startswith(prefix + "/"):
                hits.add(int(proc.name))
                break
    return sorted(hits)


def containers_mounting(path):
    """Running containers whose bind-mount source is at or under `path` (their processes see
    container-namespace paths, so /proc cannot show this use)."""
    ids = subprocess.run(["docker", "ps", "-q"], capture_output=True, text=True)
    if ids.returncode != 0 or not ids.stdout.split():
        return []
    out = subprocess.run(
        ["docker", "inspect", "-f", "{{.Name}}{{range .Mounts}} {{.Source}}{{end}}", *ids.stdout.split()],
        capture_output=True, text=True,
    )
    prefix = str(path)
    hits = []
    for line in out.stdout.splitlines():
        name, *sources = line.split()
        if any(s == prefix or s.startswith(prefix + "/") for s in sources):
            hits.append(name.lstrip("/"))
    return hits


def size_of(path):
    if path.is_symlink() or path.is_file():
        return path.lstat().st_size
    total = 0
    for dirpath, _, files in os.walk(path):
        for f in files:
            try:
                total += os.lstat(os.path.join(dirpath, f)).st_size
            except OSError:
                pass
    return total


def remove_root_owned(path):
    """Finish a removal that hit root-owned files, e.g. the runc/overlay state a rootful BuildKit
    leaves in a bind-mounted state dir. The path was already validated and its parent resolved, so
    only the parent is mounted into a throwaway container, and `rm -rf` never follows symlinks."""
    print(f"root-owned files under {path}; removing through a throwaway container")
    subprocess.run(["docker", "run", "--rm", "--network", "none",
                    "-v", f"{path.parent}:/parent", "alpine:3",
                    "rm", "-rf", "--", f"/parent/{path.name}"], check=True)
    if path.exists() or path.is_symlink():
        fail(f"could not remove {path}")


def clean_paths(raws, dry):
    freed = 0
    for raw in raws:
        path = allowed_path(raw)
        if not path.exists() and not path.is_symlink():
            print(f"absent  {path}")
            continue
        pids = users_of(path)
        if pids:
            fail(f"refused: {path} is in use by pid(s) {pids}")
        mounts = containers_mounting(path)
        if mounts:
            fail(f"refused: {path} is bind-mounted by running container(s) {mounts}")
        size = size_of(path)
        if not dry:
            if path.is_dir() and not path.is_symlink():
                try:
                    shutil.rmtree(path)
                except PermissionError:
                    remove_root_owned(path)
            else:
                path.unlink()
        freed += size
        print(f"{'would remove' if dry else 'removed'} {path} ({size / 2**30:.2f} GiB)")
    print(f"total {freed / 2**30:.2f} GiB")


def owned_container(name, owner):
    """Prove a disposable container belongs to the asserted scratch root, on any branch.

    Names alone are insufficient for new project namespaces. Require a bind witness,
    no foreign writable bind, and no service restart policy; pin deletion to the ID.
    Docker volumes are deliberately excluded from ownership/deletion decisions.
    """
    if (not re.fullmatch(r"[a-z0-9][a-z0-9_.-]*", name)
            or not re.search(r"(?:^|[-_.])(audit|test|bench|acceptance|cache|build)(?:[-_.]|$)", name)):
        fail(f"refused: {name} lacks a disposable test/audit/build name")
    result = subprocess.run(["docker", "inspect", name], capture_output=True, text=True)
    if result.returncode:
        if "no such object:" in result.stderr.lower() or "no such container:" in result.stderr.lower():
            return None
        fail(f"could not inspect container {name}")
    try:
        records = json.loads(result.stdout)
        if not isinstance(records, list) or len(records) != 1:
            raise ValueError
        record = records[0]
        state = record["State"]
        policy = record["HostConfig"]["RestartPolicy"]["Name"]
        mounts = record["Mounts"]
        if (record["Name"] != "/" + name or not re.fullmatch(r"[0-9a-f]{64}", record["Id"])
                or policy not in ("", "no") or not isinstance(state["Running"], bool)
                or state.get("Paused") is not False or state.get("Restarting") is not False
                or not isinstance(mounts, list)):
            raise ValueError
        witnessed = False
        for mount in mounts:
            if mount["Type"] != "bind":
                continue
            source = Path(mount["Source"]).resolve()
            inside = source == owner or owner in source.parents
            witnessed |= inside
            if not inside and mount.get("RW") is not False:
                fail(f"refused: {name} has a writable bind outside its owner root")
        if not witnessed:
            fail(f"refused: {name} has no bind into the asserted owner root")
    except (KeyError, TypeError, ValueError, OSError):
        fail(f"refused: {name} has unknown ownership, identity or service state")
    return record


def clean_containers(names, dry, running_ok, owner_root=None, networks=()):
    owner = None
    if owner_root is not None:
        owner = allowed_path(owner_root)
        if (not any(root in owner.parents for root in TMP_ROOTS) or owner.is_symlink()
                or not owner.is_dir() or owner.stat().st_uid != os.getuid()
                or owner.stat().st_mode & 0o022):
            fail("refused: --owner-root must be an owned, non-shared directory inside an agent scratch root")
    stack_networks = []
    if networks:
        if owner is None:
            fail("refused: --network requires --owner-root")
        proof_path = owner / ".agent-clean-networks.json"
        proofs = {}
        if proof_path.exists() or proof_path.is_symlink():
            info = proof_path.lstat()
            if (proof_path.is_symlink() or not proof_path.is_file()
                    or info.st_uid != os.getuid() or info.st_mode & 0o077 or info.st_size > 1048576):
                fail("refused: unsafe stack network ownership receipt")
            try:
                proofs = json.loads(proof_path.read_text())
            except (OSError, ValueError):
                fail("refused: invalid stack network ownership receipt")
            if not isinstance(proofs, dict):
                fail("refused: invalid stack network ownership receipt")
        records = [owned_container(name, owner) for name in names]
        if any(record and record["State"]["Running"] for record in records) and not running_ok:
            fail("refused: stack has a running container; explicit --running required")
        owned_ids = {record["Id"] for record in records if record is not None}
        for name in networks:
            if (not re.fullmatch(r"[a-z0-9][a-z0-9_.-]*", name)
                    or not re.search(r"(?:^|[-_.])(audit|test|bench|acceptance|cache|build)(?:[-_.]|$)", name)):
                fail("refused: network lacks a disposable test/audit/build name")
            found = docker_json(["network", "inspect", name])
            if not isinstance(found, list) or len(found) != 1:
                fail("refused: expected exactly one stack network")
            network = found[0]
            endpoints = network.get("Containers")
            identity = {key: value for key, value in network.items() if key not in ("Containers", "Status")}
            witnessed = isinstance(endpoints, dict) and endpoints and set(endpoints).issubset(owned_ids)
            resumed = endpoints == {} and proofs.get(name) == identity
            if (network.get("Name") != name or not re.fullmatch(r"[0-9a-f]{64}", network.get("Id", ""))
                    or network.get("Driver") != "bridge" or network.get("Scope") != "local"
                    or network.get("Ingress") is not False or network.get("ConfigOnly") is not False
                    or not (witnessed or resumed)):
                fail("refused: network is not exclusively attached to this proven owned stack")
            stack_networks.append(network)
            proofs[name] = identity
        if not dry:
            # Save the proven full identity before removing its bind-owned endpoint witnesses.
            # This allows a conservative refusal/interruption to resume after containers are gone.
            descriptor = os.open(proof_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
            with os.fdopen(descriptor, "w") as receipt:
                json.dump(proofs, receipt)
    for name in names:
        identifier = name
        if owner is not None:
            record = owned_container(name, owner)
            if record is None:
                print(f"absent  container {name}")
                continue
            identifier, running = record["Id"], record["State"]["Running"]
        else:
            never = CONTAINER_NEVER.search(name) and not CONTAINER_AGENT_OWNED.match(name)
            if never or not CONTAINER_OK.match(name):
                fail(f"refused: container {name} is not an agent test stack or builder; "
                     "use --owner-root for a disposable stack bound to your agent scratch directory")
            state = subprocess.run(["docker", "inspect", "-f", "{{.State.Running}}", name],
                                   capture_output=True, text=True)
            if state.returncode != 0:
                print(f"absent  container {name}")
                continue
            running = state.stdout.strip() == "true"
        if running and not running_ok:
            fail(f"refused: container {name} is running; pass --running only for a stack you created "
                 "and have finished with (prefer the owner tool, e.g. `sift-test-infra down`)")
        if dry:
            print(f"would remove container {name}")
            continue
        # `docker rm -f` without `-v`: named and anonymous volumes are kept.
        subprocess.run(["docker", "rm", "-f", identifier], check=True)
    for network in stack_networks:
        if dry:
            print(f"would remove network {network['Name']} after removing its owned containers")
            continue
        found = docker_json(["network", "inspect", network["Id"]])
        identity = lambda item: {key: value for key, value in item.items() if key not in ("Containers", "Status")}
        if (not isinstance(found, list) or len(found) != 1 or found[0].get("Containers") != {}
                or identity(found[0]) != identity(network)):
            fail("refused: stack network changed or still has attached endpoints")
        # Docker independently refuses deletion if an endpoint attaches after inspection.
        subprocess.run(["docker", "network", "rm", network["Id"]], check=True)



def docker_json(arguments):
    result = subprocess.run(["docker", *arguments], capture_output=True, text=True)
    if result.returncode:
        fail(f"Docker inspection failed: {' '.join(arguments[:2])}")
    try:
        return json.loads(result.stdout)
    except (ValueError, TypeError):
        fail("Docker inspection returned invalid JSON")


def network_facts(identifier, owner, common):
    networks = docker_json(["network", "inspect", identifier])
    if not isinstance(networks, list) or len(networks) != 1:
        fail("expected exactly one network")
    network = networks[0]
    if identifier not in (network.get("Id"), network.get("Name")):
        fail("refused: name or full network ID required; abbreviated IDs are ambiguous")
    labels = network.get("Labels") or {}
    project = labels.get("com.docker.compose.project", "")
    # Reuse the container cleanup ownership boundary, then narrow to canonical
    # inner test stacks. Acceptance/lifecycle cleanup remains with its owner.
    witness = project + "-postgres-1"
    if (not CONTAINER_OK.fullmatch(witness) or CONTAINER_NEVER.search(witness)
            or not re.fullmatch(r"sift-test-[0-9a-f]{12}", project)):
        fail("refused: network is not a canonical inner Sift test stack")
    expected = {
        "com.docker.compose.network": "default",
        "dev.sift.test-infra.schema": "1",
        "dev.sift.test-infra.uid": str(os.getuid()),
        "dev.sift.test-infra.stack": project,
        "dev.sift.test-infra.worktree": owner,
        "dev.sift.test-infra.git-common-dir": common,
        "dev.sift.test-infra.flavor": "inner",
        "dev.sift.test-infra.run": "-",
        "dev.sift.test-infra.state-dir": owner + "/.local/test-infra",
    }
    if any(labels.get(key) != value for key, value in expected.items()):
        fail("refused: network ownership labels do not match the asserted owner")
    if (network.get("Name") != project + "_default" or network.get("Driver") != "bridge"
            or not re.fullmatch(r"[0-9a-f]{64}", network.get("Id", ""))):
        fail("refused: system, foreign or noncanonical network")
    if "Containers" not in network or network["Containers"] != {}:
        fail("refused: network has attached endpoints or unknown endpoint state")
    refs = subprocess.run(["docker", "ps", "-aq", "--filter", f"label=com.docker.compose.project={project}"],
                          capture_output=True, text=True)
    if refs.returncode:
        fail("could not inspect project containers")
    ids = refs.stdout.split()
    if ids:
        containers = docker_json(["inspect", *ids])
        if len(containers) != len(ids):
            fail("incomplete project container inspection")
        for container in containers:
            state = container.get("State") or {}
            if ((container.get("Config", {}).get("Labels") or {}).get("com.docker.compose.project") != project
                    or state.get("Status") not in ("exited", "dead")
                    or state.get("Running") is not False or state.get("Paused") is not False
                    or state.get("Restarting") is not False):
                fail("refused: project has running, transitional or unknown container references")
    return network


def clean_networks(argv):
    parser = argparse.ArgumentParser(prog="agent-clean network")
    parser.add_argument("--owner-worktree", required=True)
    parser.add_argument("--owner-git-common-dir", required=True)
    parser.add_argument("--execute", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("networks", nargs="+")
    options = parser.parse_args(argv)
    if options.execute and options.dry_run:
        fail("--execute and --dry-run cannot be combined")
    owner, common = options.owner_worktree, options.owner_git_common_dir
    if any(not Path(path).is_absolute() or os.path.normpath(path) != path for path in (owner, common)):
        fail("owner paths must be exact absolute normalized ownership labels")
    for identifier in options.networks:
        first = network_facts(identifier, owner, common)
        lock_path = Path(owner) / ".local/test-infra/use.lock"
        # Do not create a missing fixture lease. Exact owner assertions are
        # required even for preview, including fixtures whose owner has gone.
        try:
            lease = lock_path.open("rb")
        except FileNotFoundError:
            lease = None
        try:
            if lease is not None:
                try:
                    fcntl.flock(lease, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    fail("refused: test stack use.lock is held")
            if not options.execute:
                print(f"would remove network {first['Id']} ({first['Name']}); containers and volumes preserved")
                continue
            # Pin the resolved full ID and re-inspect endpoints, ownership and
            # project container states while holding any existing use lease.
            final = network_facts(first["Id"], owner, common)
            if final != first:
                fail("refused: network changed before removal")
            # Docker also refuses removal if an endpoint attaches after the check.
            subprocess.run(["docker", "network", "rm", first["Id"]], check=True)
        finally:
            if lease is not None:
                lease.close()


def main(argv):
    if argv and argv[0] == "network":
        clean_networks(argv[1:])
        return
    dry = "--dry-run" in argv
    running_ok = "--running" in argv
    args = [a for a in argv if a not in ("--dry-run", "--running")]
    if len(args) < 2 or args[0] not in ("path", "docker"):
        fail("usage: agent-clean [--dry-run] path PATH... | [--dry-run] [--running] docker NAME...")
    if args[0] == "path":
        clean_paths(args[1:], dry)
    else:
        parser = argparse.ArgumentParser(prog="agent-clean docker")
        parser.add_argument("--owner-root", help="owned agent scratch directory containing stack bind mounts")
        parser.add_argument("--network", action="append", default=[],
                            help="explicit disposable network attached exclusively to this owned stack")
        parser.add_argument("names", nargs="+")
        options = parser.parse_args(args[1:])
        clean_containers(options.names, dry, running_ok, options.owner_root, options.network)


if __name__ == "__main__":
    main(sys.argv[1:])
