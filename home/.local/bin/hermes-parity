#!/usr/bin/env python3
"""Verify that every local Hermes surface resolves the same agent."""

from __future__ import annotations

import json
import os
import stat
import subprocess
import sys
from pathlib import Path

import yaml


def env_path(name: str, default: Path) -> Path:
    return Path(os.environ.get(name, str(default))).expanduser().resolve()


def main() -> int:
    args = sys.argv[1:]
    live = "--live" in args
    args = [arg for arg in args if arg != "--live"]
    if args not in ([], ["check"]):
        print("usage: hermes-parity [check] [--live]", file=sys.stderr)
        return 2

    user_home = Path.home()
    hermes_home = env_path(
        "HERMES_PARITY_HOME",
        Path(os.environ.get("HERMES_HOME", user_home / ".hermes")),
    )
    runtime_root = env_path(
        "HERMES_PARITY_RUNTIME_ROOT", hermes_home / "hermes-agent"
    )
    runtime_python = runtime_root / "venv/bin/python"
    runtime_hermes = runtime_root / "venv/bin/hermes"
    desktop_file = env_path(
        "HERMES_PARITY_DESKTOP_FILE",
        user_home / ".local/share/applications/hermes.desktop",
    )
    desktop_unit = env_path(
        "HERMES_PARITY_DESKTOP_UNIT",
        user_home / ".config/systemd/user/hermes-desktop.service",
    )
    gateway_dropin = env_path(
        "HERMES_PARITY_GATEWAY_DROPIN",
        user_home
        / ".config/systemd/user/hermes-gateway.service.d/10-agent-vault.conf",
    )
    secret_helper = env_path(
        "HERMES_PARITY_SECRET_HELPER",
        user_home / ".local/libexec/hermes-secret-env",
    )
    credential_store = env_path(
        "HERMES_PARITY_CREDENTIAL_STORE",
        user_home / ".config/credstore.encrypted",
    )

    errors: list[str] = []

    def require(condition: bool, message: str) -> None:
        if not condition:
            errors.append(message)

    for label, path in (
        ("Hermes config", hermes_home / "config.yaml"),
        ("Hindsight config", hermes_home / "hindsight/config.json"),
        ("Hermes runtime Python", runtime_python),
        ("Hermes runtime CLI", runtime_hermes),
        ("Desktop launcher", desktop_file),
        ("Desktop service", desktop_unit),
        ("gateway drop-in", gateway_dropin),
        ("secret helper", secret_helper),
    ):
        require(path.exists(), f"{label} missing: {path}")

    if errors:
        for error in errors:
            print(f"FAIL: {error}")
        return 1

    config = yaml.safe_load((hermes_home / "config.yaml").read_text()) or {}
    hindsight = json.loads((hermes_home / "hindsight/config.json").read_text())
    model = config.get("model") if isinstance(config.get("model"), dict) else {}
    memory = config.get("memory") if isinstance(config.get("memory"), dict) else {}
    secrets = config.get("secrets") if isinstance(config.get("secrets"), dict) else {}
    command_source = (
        secrets.get("command") if isinstance(secrets.get("command"), dict) else {}
    )

    require(memory.get("provider") == "hindsight", "Hermes memory provider is not Hindsight")
    require(hindsight.get("mode") == "local_embedded", "Hindsight mode is not local_embedded")
    require(
        hindsight.get("llm_base_url") == model.get("base_url"),
        "Hindsight LLM base URL differs from Hermes",
    )
    require(
        hindsight.get("llm_model") == model.get("default"),
        "Hindsight LLM model differs from Hermes",
    )
    require(
        model.get("key_env") == "LITELLM_MASTER_KEY",
        "Hermes model key_env is not LITELLM_MASTER_KEY",
    )
    require(command_source.get("enabled") is True, "Hermes command secret source is disabled")
    configured_helper = Path(str(command_source.get("command", ""))).expanduser()
    require(
        configured_helper.resolve() == secret_helper,
        "Hermes command secret source does not use the canonical helper",
    )

    desktop_text = desktop_file.read_text()
    desktop_unit_text = desktop_unit.read_text()
    gateway_text = gateway_dropin.read_text()
    require(
        "Exec=/usr/bin/systemctl --user start hermes-desktop.service" in desktop_text,
        "Desktop launcher does not start the managed Hermes service",
    )
    for label, text in (("Desktop service", desktop_unit_text), ("gateway drop-in", gateway_text)):
        require(str(hermes_home) in text, f"{label} does not pin HERMES_HOME")
    require(str(runtime_root) in desktop_unit_text, "Desktop service does not pin the runtime root")
    require(str(runtime_hermes) in desktop_unit_text, "Desktop service does not pin the Hermes CLI")
    require(str(runtime_python) in gateway_text, "gateway drop-in does not pin runtime Python")

    require(os.access(secret_helper, os.X_OK), "secret helper is not executable")
    for name in (
        "hermes-agent-vault-token",
        "hermes-hass-token",
        "hermes-litellm-key",
    ):
        path = credential_store / f"{name}.cred"
        require(path.exists(), f"encrypted credential missing: {path}")
        if path.exists():
            mode = stat.S_IMODE(path.stat().st_mode)
            require(mode & 0o077 == 0, f"encrypted credential is group/world accessible: {path}")

    dotfiles_home = user_home / ".dotfiles/home"
    if dotfiles_home.is_dir():
        for live_path in (desktop_file, desktop_unit, gateway_dropin, secret_helper):
            try:
                relative = live_path.relative_to(user_home)
            except ValueError:
                continue
            source = dotfiles_home / relative
            if source.exists():
                require(live_path.is_symlink(), f"managed dotfile is not a symlink: {live_path}")
                if live_path.is_symlink():
                    require(live_path.resolve() == source.resolve(), f"managed dotfile points elsewhere: {live_path}")

    if live:
        result = subprocess.run(
            [
                "systemctl",
                "--user",
                "is-active",
                "agent-vault.service",
                "hermes-gateway.service",
                "litellm.service",
                "llama-swap.service",
            ],
            check=False,
            capture_output=True,
            text=True,
        )
        require(result.returncode == 0, "one or more required user services are not active")

    if errors:
        for error in errors:
            print(f"FAIL: {error}")
        return 1

    print("Hermes parity: OK")
    print(f"  home: {hermes_home}")
    print(f"  runtime: {runtime_root}")
    print(f"  model: {model.get('default')}")
    print("  memory: Hindsight local_embedded")
    print("  credentials: canonical encrypted source (values not inspected)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
