#!/usr/bin/env bash
# PATH shim over omarchy's stock omarchy-capture-screenshot (~/.local/bin
# precedes ~/.local/share/omarchy/bin in the session PATH, so the PRINT bind
# and omarchy-menu both land here; the stock script stays pristine for
# omarchy updates).
#
# Why: the night-color screen shader (colortemp-ctl; nvidia gamma workaround)
# runs in Hyprland's final render pass, so every screencopy is tinted — DOUBLY
# here, because the hyprpicker freeze layer captures warm pixels and the
# compositor shades them again before grim grabs the frame → deep-red
# screenshots. `colortemp-ctl bypass` clears the shader for the capture and
# restores the current Kelvin on any exit, cancel included. Same fix as
# ~/bin/screenshot.
#
# Re-press-to-cancel stays correct: the second invocation's bypass sees the
# first one still owns the shader and only runs the stock script, whose
# `pkill slurp` unwinds the first invocation, which then restores.

exec "$HOME/bin/colortemp-ctl" bypass "$HOME/.local/share/omarchy/bin/omarchy-capture-screenshot" "$@"
