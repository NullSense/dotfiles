#!/usr/bin/env bash
set -euo pipefail

# Hermes invokes this through its profile-scoped `secrets.command` provider.
# It emits a dotenv-shaped allowlist on stdout; callers must never log stdout.

emit_var() {
    local name=$1
    if [[ -n ${!name:-} ]]; then
        printf '%s=%s\n' "$name" "${!name}"
    fi
}

emit_environment() {
    local name
    for name in \
        AGENT_VAULT_ADDR \
        AGENT_VAULT_TOKEN \
        AGENT_VAULT_VAULT \
        HASS_TOKEN \
        LITELLM_API_KEY \
        HINDSIGHT_LLM_API_KEY \
        HTTP_PROXY \
        HTTPS_PROXY \
        NO_PROXY \
        NODE_USE_ENV_PROXY \
        SSL_CERT_FILE \
        NODE_EXTRA_CA_CERTS \
        REQUESTS_CA_BUNDLE \
        CURL_CA_BUNDLE \
        GIT_SSL_CAINFO \
        DENO_CERT \
        HERMES_SECRETS_RESOLVED
    do
        emit_var "$name"
    done
}

if (( $# > 0 )) && ! [[ $# == 1 && $1 == --emit && ${HERMES_SECRET_ENV_INTERNAL:-} == 1 ]]; then
    printf 'hermes-secret-env: this is a dotenv provider, not a command wrapper\n' >&2
    exit 64
fi

if [[ ${1:-} == --emit ]]; then
    emit_environment
    exit 0
fi

# A Desktop-spawned backend inherits the already resolved environment from
# the Desktop parent. Avoid decrypting and validating the same credentials a
# second time while keeping fresh top-level CLI/Desktop/gateway starts
# authoritative.
if [[ ${HERMES_SECRETS_RESOLVED:-} == 1 ]]; then
    emit_environment
    exit 0
fi

credential_store=${HERMES_CREDENTIAL_STORE:-$HOME/.config/credstore.encrypted}
systemd_creds_bin=${HERMES_SECRET_SYSTEMD_CREDS_BIN:-/usr/bin/systemd-creds}
agent_vault_bin=${HERMES_SECRET_AGENT_VAULT_BIN:-/usr/local/bin/agent-vault}

load_credential() {
    local env_name=$1
    local credential_name=$2
    local value

    if [[ -n ${CREDENTIALS_DIRECTORY:-} && -r $CREDENTIALS_DIRECTORY/$credential_name ]]; then
        value=$(<"$CREDENTIALS_DIRECTORY/$credential_name")
    else
        value=$(
            "$systemd_creds_bin" decrypt --user --name="$credential_name" \
                "$credential_store/$credential_name.cred" -
        )
    fi

    if [[ -z $value ]]; then
        printf 'hermes-secret-env: credential %s resolved empty\n' "$credential_name" >&2
        exit 1
    fi
    printf -v "$env_name" '%s' "$value"
    export "${env_name?}"
}

load_credential AGENT_VAULT_TOKEN hermes-agent-vault-token
load_credential HASS_TOKEN hermes-hass-token
load_credential LITELLM_API_KEY hermes-litellm-key

export AGENT_VAULT_ADDR=${AGENT_VAULT_ADDR:-http://127.0.0.1:14321}
export AGENT_VAULT_VAULT=${AGENT_VAULT_VAULT:-hermes}
export HINDSIGHT_LLM_API_KEY=$LITELLM_API_KEY
export HERMES_SECRETS_RESOLVED=1

# Use Agent Vault's supported launcher to validate the scoped token and derive
# the proxy/CA environment. The child only emits the explicit allowlist above.
export HERMES_SECRET_ENV_INTERNAL=1

# Bounded retry rather than a bare `exec`. A single transient `agent-vault run`
# failure (vault mid-restart, MITM proxy port still binding) otherwise propagates
# to Hermes as "no secrets applied" — indistinguishable from a real
# misconfiguration. Hermes then ships the *placeholder* values onward, Telegram
# rejects `__telegram_bot_token__`, and the gateway exits 78/CONFIG, which
# RestartPreventExitStatus=78 refuses to restart. Observed 2026-08-17 05:05.
# Keep the total comfortably inside secrets.command.helper_timeout_seconds.
attempts=${HERMES_SECRET_ENV_ATTEMPTS:-3}
retry_delay=${HERMES_SECRET_ENV_RETRY_DELAY:-1}

for (( attempt = 1; attempt <= attempts; attempt++ )); do
    if emitted=$("$agent_vault_bin" run -- "$0" --emit) && [[ -n $emitted ]]; then
        printf '%s\n' "$emitted"
        exit 0
    fi
    printf 'hermes-secret-env: agent-vault run produced no environment (attempt %d/%d)\n' \
        "$attempt" "$attempts" >&2
    if (( attempt < attempts )); then
        sleep "$retry_delay"
    fi
done

printf 'hermes-secret-env: agent-vault run did not succeed after %d attempts\n' "$attempts" >&2
exit 1
