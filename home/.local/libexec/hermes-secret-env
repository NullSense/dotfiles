#!/usr/bin/env bash
set -euo pipefail

# Hermes invokes this through its profile-scoped `secrets.command` provider.
# It emits a dotenv-shaped allowlist on stdout; callers must never log stdout.

emit_var() {
    local name=$1
    if [[ -n ${!name:-} ]]; then
        printf '%s=%s\n' "$name" "${!name}"
    fi
}

emit_environment() {
    local name
    for name in \
        AGENT_VAULT_ADDR \
        AGENT_VAULT_TOKEN \
        AGENT_VAULT_VAULT \
        HASS_TOKEN \
        LITELLM_MASTER_KEY \
        HINDSIGHT_LLM_API_KEY \
        HTTP_PROXY \
        HTTPS_PROXY \
        NO_PROXY \
        NODE_USE_ENV_PROXY \
        SSL_CERT_FILE \
        NODE_EXTRA_CA_CERTS \
        REQUESTS_CA_BUNDLE \
        CURL_CA_BUNDLE \
        GIT_SSL_CAINFO \
        DENO_CERT \
        HERMES_SECRETS_RESOLVED
    do
        emit_var "$name"
    done
}

if [[ ${1:-} == --emit ]]; then
    emit_environment
    exit 0
fi

# A Desktop-spawned backend inherits the already resolved environment from
# the Desktop parent. Avoid decrypting and validating the same credentials a
# second time while keeping fresh top-level CLI/Desktop/gateway starts
# authoritative.
if [[ ${HERMES_SECRETS_RESOLVED:-} == 1 ]]; then
    emit_environment
    exit 0
fi

credential_store=${HERMES_CREDENTIAL_STORE:-$HOME/.config/credstore.encrypted}
systemd_creds_bin=${HERMES_SECRET_SYSTEMD_CREDS_BIN:-/usr/bin/systemd-creds}
agent_vault_bin=${HERMES_SECRET_AGENT_VAULT_BIN:-/usr/local/bin/agent-vault}

load_credential() {
    local env_name=$1
    local credential_name=$2
    local value

    if [[ -n ${CREDENTIALS_DIRECTORY:-} && -r $CREDENTIALS_DIRECTORY/$credential_name ]]; then
        value=$(<"$CREDENTIALS_DIRECTORY/$credential_name")
    else
        value=$(
            "$systemd_creds_bin" decrypt --user --name="$credential_name" \
                "$credential_store/$credential_name.cred" -
        )
    fi

    if [[ -z $value ]]; then
        printf 'hermes-secret-env: credential %s resolved empty\n' "$credential_name" >&2
        exit 1
    fi
    printf -v "$env_name" '%s' "$value"
    export "$env_name"
}

load_credential AGENT_VAULT_TOKEN hermes-agent-vault-token
load_credential HASS_TOKEN hermes-hass-token
load_credential LITELLM_MASTER_KEY hermes-litellm-key

export AGENT_VAULT_ADDR=${AGENT_VAULT_ADDR:-http://127.0.0.1:14321}
export AGENT_VAULT_VAULT=${AGENT_VAULT_VAULT:-hermes}
export HINDSIGHT_LLM_API_KEY=$LITELLM_MASTER_KEY
export HERMES_SECRETS_RESOLVED=1

# Use Agent Vault's supported launcher to validate the scoped token and derive
# the proxy/CA environment. The child only emits the explicit allowlist above.
exec "$agent_vault_bin" run -- "$0" --emit
