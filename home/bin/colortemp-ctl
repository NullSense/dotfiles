#!/usr/bin/env sh
# Stable Waybar interface for monitor-side color profiles. Hardware quirks stay
# here so callers do not need to know which monitor adapter is active.

set -eu

GBMONCTL=${COLORTEMP_GBMONCTL:-gbmonctl}
STATE_DIR=${COLORTEMP_STATE_DIR:-${XDG_STATE_HOME:-"$HOME/.local/state"}/colortemp}
STATE_FILE="$STATE_DIR/profile"
LOCK_FILE="$STATE_DIR/lock"
SIGNAL_NUM=13

usage() {
    printf 'usage: %s get|warmer|cooler|toggle|night|day|auto\n' "$0" >&2
    exit 2
}

has_supported_monitor() {
    if [ -n "${COLORTEMP_DEVICE_AVAILABLE:-}" ]; then
        [ "$COLORTEMP_DEVICE_AVAILABLE" = 1 ]
        return
    fi

    # FO32U2 USB OSD endpoint. Keep discovery inside this module; Waybar and
    # systemd remain unchanged when another monitor adapter is added later.
    for device_info in /sys/class/hidraw/hidraw*/device/uevent; do
        [ -r "$device_info" ] || continue
        if grep -q '^HID_ID=.*:00000BDA:00001100$' "$device_info"; then
            return 0
        fi
    done
    return 1
}

scheduled_profile() {
    hour=${COLORTEMP_HOUR:-$(date +%H)}
    hour=${hour#0}
    [ -n "$hour" ] || hour=0

    if [ "$hour" -ge 19 ] || [ "$hour" -lt 6 ]; then
        printf 'warm\n'
    else
        printf 'normal\n'
    fi
}

read_profile() {
    if [ -r "$STATE_FILE" ]; then
        profile=$(sed -n '1p' "$STATE_FILE")
        case "$profile" in
            warm|normal|cool)
                printf '%s\n' "$profile"
                return
                ;;
        esac
    fi
    scheduled_profile
}

mode_for_profile() {
    case "$1" in
        cool) printf '0\n' ;;
        normal) printf '1\n' ;;
        warm) printf '2\n' ;;
        *) return 1 ;;
    esac
}

notify_waybar() {
    systemctl --user kill --kill-whom=main --signal=RTMIN+"$SIGNAL_NUM" waybar.service 2>/dev/null || true
}

apply_profile() {
    target=$1

    if ! has_supported_monitor || ! command -v "$GBMONCTL" >/dev/null 2>&1; then
        printf 'colortemp-ctl: compatible monitor USB control is not available\n' >&2
        return 1
    fi

    # FO32U2 exposes three working hardware color modes. Its older M-series
    # RGB and low-blue-light property IDs acknowledge writes but do not alter
    # this panel, so do not advertise fake continuous Kelvin control.
    "$GBMONCTL" -prop colour-mode -val "$(mode_for_profile "$target")" >/dev/null
    printf '%s\n' "$target" >"$STATE_FILE"
}

transition_to() {
    target=$1
    force=${2:-false}

    if [ "$force" != true ] && [ "$(read_profile)" = "$target" ]; then
        return
    fi

    apply_profile "$target"
    notify_waybar
}

command_name=${1:-get}

if [ "$command_name" = get ]; then
    if ! has_supported_monitor || ! command -v "$GBMONCTL" >/dev/null 2>&1; then
        printf 'off'
    else
        read_profile | tr -d '\n'
    fi
    exit 0
fi

mkdir -p "$STATE_DIR"
exec 9>"$LOCK_FILE"
flock 9

case "$command_name" in
    warmer)
        case "$(read_profile)" in
            cool) transition_to normal ;;
            normal) transition_to warm ;;
            warm) : ;;
        esac
        ;;
    cooler)
        case "$(read_profile)" in
            warm) transition_to normal ;;
            normal) transition_to cool ;;
            cool) : ;;
        esac
        ;;
    toggle)
        if [ "$(read_profile)" = warm ]; then
            transition_to normal
        else
            transition_to warm
        fi
        ;;
    night)
        transition_to warm
        ;;
    day)
        transition_to normal
        ;;
    auto)
        # Force restores the desired hardware mode after login or hotplug even
        # when the persisted profile already matches the clock.
        transition_to "$(scheduled_profile)" true
        ;;
    *)
        usage
        ;;
esac
