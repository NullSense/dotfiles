#!/usr/bin/env sh
# Waybar controller for hyprsunset's per-output color transform.
#
# The daemon applies one CTM to every connected Wayland output, including
# outputs hot-plugged after startup. This wrapper owns only the user-facing
# policy: 100K scroll steps, a 2500K floor, neutral day mode at 6500K, and a
# 4000K night preset.

set -eu

HYPRCTL=${COLORTEMP_HYPRCTL:-hyprctl}
MIN_K=2500
DAY_K=6500
NIGHT_K=4000
SIGNAL_NUM=13

usage() {
    printf 'usage: %s get|+K|-K|toggle|night|day\n' "$0" >&2
    exit 2
}

get_identity() {
    "$HYPRCTL" hyprsunset identity get 2>/dev/null
}

get_kelvin() {
    "$HYPRCTL" hyprsunset temperature 2>/dev/null
}

notify_waybar() {
    pkill -RTMIN+"$SIGNAL_NUM" waybar 2>/dev/null || true
}

set_day() {
    # Keep the daemon's latent temperature at the neutral ceiling so the next
    # scroll-down from identity mode starts smoothly at 6400K.
    "$HYPRCTL" hyprsunset temperature "$DAY_K" >/dev/null
    "$HYPRCTL" hyprsunset identity >/dev/null
}

set_kelvin() {
    target=$1
    [ "$target" -lt "$MIN_K" ] && target=$MIN_K

    if [ "$target" -ge "$DAY_K" ]; then
        set_day
    else
        "$HYPRCTL" hyprsunset temperature "$target" >/dev/null
    fi
}

case "${1:-get}" in
    get)
        if ! identity=$(get_identity); then
            printf 'off'
            exit 0
        fi

        if [ "$identity" = true ]; then
            printf '%sK' "$DAY_K"
        elif kelvin=$(get_kelvin); then
            printf '%sK' "$kelvin"
        else
            printf 'off'
        fi
        exit 0
        ;;
    +*|-*)
        delta=$1
        magnitude=${delta#?}
        case "$magnitude" in
            ''|*[!0-9]*) usage ;;
        esac

        identity=$(get_identity)
        if [ "$identity" = true ]; then
            current=$DAY_K
        else
            current=$(get_kelvin)
        fi

        case "$current" in
            ''|*[!0-9]*)
                printf 'colortemp-ctl: invalid temperature from hyprsunset: %s\n' "$current" >&2
                exit 1
                ;;
        esac

        if [ "${delta%"$magnitude"}" = + ]; then
            target=$((current + magnitude))
        else
            target=$((current - magnitude))
        fi
        set_kelvin "$target"
        ;;
    toggle)
        if [ "$(get_identity)" = true ]; then
            set_kelvin "$NIGHT_K"
        else
            set_day
        fi
        ;;
    night)
        set_kelvin "$NIGHT_K"
        ;;
    day)
        set_day
        ;;
    *)
        usage
        ;;
esac

notify_waybar
