#!/usr/bin/env sh
# Stable Waybar interface for compositor-level night color. The monitor stays
# in its native-gamut 6500K hardware baseline; Hyprland owns the output shader.
#
# The shader runs in Hyprland's final render pass, so every screencopy (grim,
# hyprpicker's freeze layer) is tinted too. Screenshots must never carry it:
# capture tools run under `colortemp-ctl bypass <cmd...>`, which clears the
# shader for the command's lifetime and restores the current Kelvin on any exit.

set -eu

HYPRCTL=${COLORTEMP_HYPRCTL:-hyprctl}
# Dual-mode (hyprlang `keyword` | Lua `hl.config`) setter; see hypr-dispatch.
HYPR_DISPATCH=${COLORTEMP_HYPR_DISPATCH:-"$HOME/bin/hypr-dispatch"}
STATE_DIR=${COLORTEMP_STATE_DIR:-${XDG_STATE_HOME:-"$HOME/.local/state"}/colortemp}
STATE_FILE="$STATE_DIR/kelvin"
LOCK_FILE="$STATE_DIR/lock"
SHADER_TEMPLATE=${COLORTEMP_SHADER_TEMPLATE:-"$HOME/.config/hypr/shaders/colortemp.frag.in"}
SHADER_DIR=${COLORTEMP_SHADER_DIR:-${XDG_RUNTIME_DIR:-"$STATE_DIR"}/colortemp-shaders}
BYPASS_FILE="$STATE_DIR/bypass"
# One untinted frame must reach the screen before a freeze layer or grim grabs it.
BYPASS_SETTLE=${COLORTEMP_BYPASS_SETTLE:-0.15}
SIGNAL_NUM=13
MIN_K=2500
MAX_K=6500
NIGHT_K=4000
STEP_K=100

usage() {
    printf 'usage: %s get|warmer|cooler|night|default|auto|bypass <command> [args...]\n' "$0" >&2
    exit 2
}

scheduled_kelvin() {
    hour=${COLORTEMP_HOUR:-$(date +%H)}
    hour=${hour#0}
    [ -n "$hour" ] || hour=0

    if [ "$hour" -ge 19 ] || [ "$hour" -lt 6 ]; then
        printf '%s\n' "$NIGHT_K"
    else
        printf '%s\n' "$MAX_K"
    fi
}

read_kelvin() {
    if [ -r "$STATE_FILE" ]; then
        kelvin=$(sed -n '1p' "$STATE_FILE")
        case "$kelvin" in
            *[!0-9]*|'') ;;
            *)
                if [ "$kelvin" -ge "$MIN_K" ] && [ "$kelvin" -le "$MAX_K" ]; then
                    printf '%s\n' "$kelvin"
                    return
                fi
                ;;
        esac
    fi
    scheduled_kelvin
}

notify_waybar() {
    systemctl --user kill --kill-whom=main --signal=RTMIN+"$SIGNAL_NUM" waybar.service 2>/dev/null || true
}

send_shader() {
    target=$1

    if ! command -v "$HYPRCTL" >/dev/null 2>&1; then
        printf 'colortemp-ctl: hyprctl is not available\n' >&2
        return 1
    fi
    if [ ! -r "$SHADER_TEMPLATE" ]; then
        printf 'colortemp-ctl: shader template is not available: %s\n' "$SHADER_TEMPLATE" >&2
        return 1
    fi

    mkdir -p "$SHADER_DIR"
    shader_file="$SHADER_DIR/$target.frag"
    if [ ! -r "$shader_file" ]; then
        temporary_shader="$shader_file.tmp.$$"
        sed "s/@KELVIN@/${target}.0/g" "$SHADER_TEMPLATE" >"$temporary_shader"
        mv "$temporary_shader" "$shader_file"
    fi

    # The graphical-session oneshot can race Hyprland's command socket during
    # login. Normal scrolls succeed on the first attempt.
    attempt=1
    while ! HYPR_DISPATCH_HYPRCTL="$HYPRCTL" "$HYPR_DISPATCH" keyword decoration:screen_shader "$shader_file" \
        "hl.config({ decoration = { screen_shader = [=[$shader_file]=] } })" >/dev/null 2>&1; do
        if [ "$attempt" -ge 25 ]; then
            printf 'colortemp-ctl: Hyprland IPC did not become ready\n' >&2
            return 1
        fi
        attempt=$((attempt + 1))
        sleep 0.02
    done
}

clear_shader() {
    attempt=1
    while ! HYPR_DISPATCH_HYPRCTL="$HYPRCTL" "$HYPR_DISPATCH" keyword decoration:screen_shader '[[EMPTY]]' \
        'hl.config({ decoration = { screen_shader = "" } })' >/dev/null 2>&1; do
        if [ "$attempt" -ge 25 ]; then
            printf 'colortemp-ctl: Hyprland IPC did not become ready\n' >&2
            return 1
        fi
        attempt=$((attempt + 1))
        sleep 0.02
    done
}

# Nested bypasses (re-pressing the screenshot bind to cancel) must not restore
# the shader while the outer capture is still running, so only the outermost
# owner suspends and restores. A marker left by a SIGKILLed owner is stale.
bypass_active() {
    [ -r "$BYPASS_FILE" ] || return 1
    owner=$(sed -n '1p' "$BYPASS_FILE")
    case "$owner" in
        *[!0-9]*|'') return 1 ;;
    esac
    kill -0 "$owner" 2>/dev/null
}

bypass_restore() {
    exec 9>"$LOCK_FILE"
    flock 9
    rm -f "$BYPASS_FILE"
    send_shader "$(read_kelvin)" || true
    exec 9>&-
}

run_bypass() {
    [ "$#" -gt 0 ] || usage
    mkdir -p "$STATE_DIR"

    exec 9>"$LOCK_FILE"
    flock 9
    if bypass_active; then
        exec 9>&-
        "$@"
        return
    fi
    printf '%s\n' "$$" >"$BYPASS_FILE"
    trap 'bypass_restore' EXIT
    trap 'exit 130' INT HUP TERM
    clear_shader || true
    exec 9>&-

    sleep "$BYPASS_SETTLE"
    status=0
    "$@" || status=$?
    return "$status"
}

apply_kelvin() {
    target=$1
    # A scroll or the schedule timer mid-capture only records the new value;
    # the bypass owner applies it when the capture ends.
    bypass_active || send_shader "$target"
    printf '%s\n' "$target" >"$STATE_FILE"
}

transition_to() {
    target=$1
    force=${2:-false}

    if [ "$force" != true ] && [ "$(read_kelvin)" -eq "$target" ]; then
        return
    fi

    apply_kelvin "$target"
    notify_waybar
}

command_name=${1:-get}

if [ "$command_name" = get ]; then
    printf '%sK' "$(read_kelvin)"
    exit 0
fi

if [ "$command_name" = bypass ]; then
    shift
    status=0
    run_bypass "$@" || status=$?
    exit "$status"
fi

mkdir -p "$STATE_DIR"
exec 9>"$LOCK_FILE"
flock 9

case "$command_name" in
    warmer)
        current=$(read_kelvin)
        target=$((current - STEP_K))
        [ "$target" -ge "$MIN_K" ] || target=$MIN_K
        transition_to "$target"
        ;;
    cooler)
        current=$(read_kelvin)
        target=$((current + STEP_K))
        [ "$target" -le "$MAX_K" ] || target=$MAX_K
        transition_to "$target"
        ;;
    night)
        transition_to "$NIGHT_K"
        ;;
    default)
        transition_to "$MAX_K"
        ;;
    auto)
        # Force restores the scheduled shader after login, config reload, or
        # output hotplug even when the persisted value already matches.
        transition_to "$(scheduled_kelvin)" true
        ;;
    *)
        usage
        ;;
esac
