#!/usr/bin/env bash
# litellm-gateway — the ALWAYS-ON model gateway (:4000). Runs the MCP-free profile
# (~/.config/litellm/config.yaml) so startup is seconds, not the 40s-4min MCP tool
# discovery used to take (and stalls when a remote MCP was unreachable).
#
# Owned by systemd (litellm.service, Restart=on-failure) — NOT by `stack` pidfiles.
# The old nohup+pidfile scheme tracked the `infisical run` wrapper PID: when the
# wrapper died, orphaned litellm children kept :4000 and every restart raced
# "address already in use" (observed 2026-07-22 14:02:54). systemd's cgroup kill
# can't orphan anything. `stack up/down/restart` drive this via systemctl.
#
# Env lives HERE (per-binary wrapper), not in the unit or direnv — systemd units
# never see direnv-scoped env (see memory: agent-vault-env-systemd).
#
# Pinned installation (validated 2026-09-17):
#   uv tool install --force --upgrade 'litellm[proxy,proxy-runtime,caching,extra_proxy]==1.101.0' --with 'fastapi==0.136.3'
#   stack db-init
#   systemctl --user restart litellm.service litellm-mcp.service
# proxy supplies the server; caching supplies diskcache; extra_proxy supplies
# Prisma; proxy-runtime supplies the configured OpenTelemetry callbacks.
# FastAPI stays pinned for LiteLLM's OTel 0.49b0 instrumentation. Recheck its
# instrumented HTTP path before lifting this pin on an upgrade.
# db-init regenerates Prisma and applies the guarded engine-setter repair
# still required by 1.101.0. Schema changes fail rather than accepting data loss.
set -euo pipefail

# LiteLLM invokes the Prisma CLI as a subprocess when DATABASE_URL is set.
# uv exposes the main `litellm` entry point globally but keeps dependency
# executables inside the tool environment, so systemd's minimal PATH otherwise
# makes an installed Prisma look missing and silently disables DB setup.
export PATH="$HOME/.local/share/uv/tools/litellm/bin:$PATH"

PORT="${LITELLM_PORT:-4000}"
HOST="${LITELLM_HOST:-0.0.0.0}"
CFG="${LITELLM_CFG:-$HOME/.config/litellm/config.yaml}"

# Tracing is useful only when the optional local collector exists. Leaving the
# exporter enabled against a closed port creates an endless retry loop in both
# LiteLLM instances. `stack obs` can start the collector before restarting the
# gateways; LITELLM_OTEL_ENABLED=1 is the explicit override for remote targets.
if [[ ${LITELLM_OTEL_ENABLED:-auto} == 1 ]] ||
   { [[ ${LITELLM_OTEL_ENABLED:-auto} == auto ]] &&
     (exec 3<>/dev/tcp/127.0.0.1/4317) 2>/dev/null; }; then
  export LITELLM_OTEL_V2=true OTEL_EXPORTER="${OTEL_EXPORTER:-otlp_grpc}" \
    OTEL_ENDPOINT="${OTEL_ENDPOINT:-http://localhost:4317}" \
    OTEL_SERVICE_NAME="${OTEL_SERVICE_NAME:-litellm}" OTEL_ENVIRONMENT_NAME="${OTEL_ENV:-local}"
  unset OTEL_SDK_DISABLED
else
  export LITELLM_OTEL_V2=false OTEL_SDK_DISABLED=true
fi
# THE SWITCH: development=LOCAL (llama-swap), production=CLOUD (OpenRouter).
export LITELLM_ENVIRONMENT="${LITELLM_ENVIRONMENT:-development}"

CMD=(litellm --config "$CFG" --host "$HOST" --port "$PORT")
if [ "${LITELLM_UNSET_MASTER_KEY:-0}" = 1 ]; then
  # The loopback-only MCP instance does not need client auth. Infisical still
  # supplies its database and upstream-provider credentials, but this removes
  # the gateway master key before LiteLLM starts so it cannot activate auth.
  CMD=(env -u LITELLM_MASTER_KEY "${CMD[@]}")
fi
if [ "${STACK_NO_INFISICAL:-0}" != 1 ]; then
  # Daemons must never use a human CLI login: it expires between boots.
  # systemd decrypts the dedicated LiteLLM machine identity into private tmpfs.
  : "${CREDENTIALS_DIRECTORY:?Start LiteLLM through its systemd user service}"
  for credential in infisical-client-id infisical-client-secret; do
    [[ -s "$CREDENTIALS_DIRECTORY/$credential" ]] || {
      echo "Missing LiteLLM machine credential: $credential" >&2
      exit 1
    }
  done
  export INFISICAL_DOMAIN=https://eu.infisical.com
  unset INFISICAL_TOKEN
  export INFISICAL_UNIVERSAL_AUTH_CLIENT_ID
  export INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET
  INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=$(<"$CREDENTIALS_DIRECTORY/infisical-client-id")
  INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=$(<"$CREDENTIALS_DIRECTORY/infisical-client-secret")
  # A new short-lived access token on every start; neither secret appears in argv.
  INFISICAL_TOKEN=$(infisical login --method=universal-auth --plain --silent)
  [[ -n "$INFISICAL_TOKEN" ]] || { echo "Infisical returned an empty machine token" >&2; exit 1; }
  export INFISICAL_TOKEN
  unset INFISICAL_UNIVERSAL_AUTH_CLIENT_ID INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET
  exec infisical run --silent --projectId 723a9325-6559-4de6-8e86-c318c2e6b9fd \
    --env "${INFISICAL_ENV:-dev}" --path "${INFISICAL_PATH:-/litellm}" \
    -- env -u INFISICAL_TOKEN "${CMD[@]}"
else
  [ -n "${OPENROUTER_API_KEY:-}" ] || echo "⚠ OPENROUTER_API_KEY unset — cloud routes will 401" >&2
  [ -n "${LITELLM_MASTER_KEY:-}" ] || echo "⚠ LITELLM_MASTER_KEY unset — no admin/virtual keys" >&2
  exec "${CMD[@]}"
fi
