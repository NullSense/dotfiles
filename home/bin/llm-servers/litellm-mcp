#!/usr/bin/env bash
# litellm-mcp — the OPTIONAL MCP-aggregation instance (:4001), profile
# ~/.config/litellm/config-mcp.yaml. Slow to boot BY NATURE (discovers tools from
# every configured MCP server before uvicorn binds) — which is exactly why it is
# a separate instance and not part of the always-on gateway (litellm-gateway).
# Start/stop via `stack mcp` / `stack mcp off` (systemd litellm-mcp.service).
#
# Consumers point at http://127.0.0.1:4001/mcp/ (trailing slash). Shares
# litellm-db with the gateway (same master/virtual keys).
set -euo pipefail

# node/npx for the stdio MCP servers: NOT in the systemd PATH — mise doesn't shim
# node (proto/mise split ownership; `mise reshim` creates no node/npx shims), and
# interactive shells get it via mise PATH activation, which units never run. The
# `latest` symlink tracks mise upgrades. Without this, litellm's stdio spawn dies
# instantly → every list_tools "Connection closed" (found 2026-07-22).
export PATH="$HOME/.local/share/mise/installs/node/latest/bin:$PATH"

# agent-vault proxy for the stdio MCP subprocesses litellm spawns (NOT litellm
# core egress) — fetched HERE because systemd units never inherit direnv env.
#
# PREFERRED: a LONG-LIVED agent token (agent-vault agent create litellm-mcp
# --vault default:proxy --token-only) stored at ~/.agent-vault/litellm-mcp-token.
# Agent tokens never expire, so a long-running service can't silently outlive
# its credential. Mint/re-mint with:
#   agent-vault agent create litellm-mcp --vault default:proxy --token-only \
#     > ~/.agent-vault/litellm-mcp-token
# (re-create to rotate; the old token is then invalid.)
#
# FALLBACK: a 7d session token (--ttl 604800, the max; the default 24h TTL
# outlives a long-lived service and every vault-shielded MCP call 407s after
# ~1d — observed 2026-08-19: context7/exa dead, token from 2d ago).
_AV_TOKEN_FILE="$HOME/.agent-vault/litellm-mcp-token"
if [ -r "$_AV_TOKEN_FILE" ] && _AVT="$(cat "$_AV_TOKEN_FILE" 2>/dev/null)" && [[ "$_AVT" == av_agt_* ]]; then
  :  # long-lived agent token — no expiry
elif command -v agent-vault >/dev/null 2>&1 && _AVT="$(agent-vault vault token --vault default --ttl 604800 2>/dev/null)"; then
  echo "⚠ agent token missing — using 7d session token for litellm-mcp" >&2
fi
if [ -n "${_AVT:-}" ]; then
  export AV_HTTPS_PROXY="http://${_AVT}:default@127.0.0.1:14322"
  export AV_CA="$HOME/.agent-vault/mitm-ca.pem"
  # LiteLLM itself owns the hosted MCP connections. Route those through Agent
  # Vault so credentials are injected without appearing in this config.
  export HTTPS_PROXY="$AV_HTTPS_PROXY" HTTP_PROXY="$AV_HTTPS_PROXY"
  export SSL_CERT_FILE="$AV_CA" REQUESTS_CA_BUNDLE="$AV_CA"
  export NO_PROXY="localhost,127.0.0.1"
  # node/npm (npx bootstraps + the MCP servers' own API calls) must TRUST the
  # agent-vault MITM CA — without this, npx dies with "unable to verify the first
  # certificate" under systemd (the var used to come from the direnv session env,
  # which systemd units never see — the known agent-vault/systemd trap).
  export NODE_EXTRA_CA_CERTS="$AV_CA"
  unset _AVT
else
  echo "⚠ agent-vault token unavailable — vault-shielded MCP servers (exa/github/hf) will fail auth" >&2
fi

exec env LITELLM_HOST=127.0.0.1 LITELLM_PORT=4001 LITELLM_UNSET_MASTER_KEY=1 \
  LITELLM_CFG="$HOME/.config/litellm/config-mcp.yaml" \
  OTEL_SERVICE_NAME=litellm-mcp \
  "$(dirname "$(readlink -f "$0")")/litellm-gateway"
