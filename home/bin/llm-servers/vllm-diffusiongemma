#!/usr/bin/env bash
# vllm-diffusiongemma — serve google/diffusiongemma-26B-A4B-it (discrete text
# DIFFUSION LM, MoE 25.2B/3.8B-active) as NVFP4 on the RTX 5090 via vLLM v0.24.0.
#
# Why v0.24.0: it's the first vLLM release that registers the
# `DiffusionGemmaForBlockDiffusion` arch (0.23.0/latest do NOT). Block-diffusion
# decoding needs the V2 model runner + TRITON attention backend + the gemma4
# reasoning parser (per nvidia/diffusiongemma-26B-A4B-it-NVFP4 card).
#
# Summarization-tuned: thinking OFF (extractive task; CoT only adds latency +
# JSON corruption), NVFP4 weights (Blackwell-native 4-bit), OpenAI API on :8002.
#
# Usage:  vllm-diffusiongemma        (Ctrl-C to stop; --rm cleans up)
set -euo pipefail

MODEL="${MODEL:-nvidia/diffusiongemma-26B-A4B-it-NVFP4}"
PORT="${PORT:-8002}"
NAME="${SERVED_NAME:-diffusiongemma}"
IMAGE="${VLLM_IMAGE:-vllm/vllm-openai:v0.24.0}"
# MEASURED (2026-07-09): this 26B MoE's NVFP4 weights are ~19-20GB RESIDENT (ALL experts
# load, not just the 3.8B active — the old "11-13GB" estimate was wrong). Its runtime peak is
# ~24GB, which does NOT fit alongside BOTH E4B (~15GB) AND parakeet (~5.7GB) on a 32GB card:
#   • util 0.60 → starved the KV pool.  • util 0.70-0.74 with parakeet up → OOM (weights+profiling
#   peak exceeded the ~23GB free).  So `stack pro on` evicts BOTH E4B and parakeet → ~29GB free,
# and this runs comfortably at 0.80 with --enforce-eager (no CUDA-graph capture spike — the robust
# choice for a rarely-used eviction tier). If octen (~7.7GB) loads during the window it'll still OOM.
# Benchmarked 3 configs (2026-07-09, within the parakeet-evicted window, ~80-tok summaries):
#   baseline eager, no fp8 KV        → 350 tok/s
#   eager + fp8 KV                   → 371 tok/s
#   compile+graphs + fp8 KV (0.72)   → 394 tok/s  ← default (also populates the shared compile
#                                       cache → warm restarts skip the ~27s first-compile)
# Differences are modest (block-diffusion decodes the whole answer in parallel, so it's already
# sub-second/summary), but compile is a free ~13% + cache reuse and fits reliably at util 0.72
# now that the window frees ~29GB. Set ENFORCE_EAGER=1 for the bulletproof no-capture-spike
# fallback if anything else ever shares the GPU during the window.
GPU_UTIL="${GPU_UTIL:-0.72}"   # ~22.6GB — leaves graph-capture room; needs E4B+parakeet evicted
MAXLEN="${MAXLEN:-4096}"       # summaries are short
KV_DTYPE="${KV_DTYPE:-fp8}"    # halve KV vs bf16 (headroom + slight speed); 'auto' to disable
ENFORCE_EAGER="${ENFORCE_EAGER:-0}"   # 0 = torch.compile + CUDA graphs (fastest, uses compile cache);
                                      # 1 = eager fallback (no capture spike; use if GPU is contended)
EAGER_ARGS=(); [ "$ENFORCE_EAGER" = 1 ] && EAGER_ARGS=(--enforce-eager)

# Shared mounts + env (persistent torch.compile cache, HF cache, model tree, Blackwell
# alloc, offline HF) — one source of truth for EVERY vLLM server, no per-script drift.
VLLM_HOST_NET=1                 # loopback-only, skips docker-proxy
VLLM_SLEEP="${VLLM_SLEEP:-1}"   # /sleep + /wake_up instead of a ~60s cold restart
source "$(dirname "$(readlink -f "$0")")/_vllm-common.sh"

# Overridable so a smoke test / bench can run its OWN container instead of
# killing the live llama-swap one that shares this name (vllm-update did
# exactly that until 2026-08-06). Default keeps the llama-swap identity.
: "${CONTAINER_NAME:=vllm-diffusiongemma}"

docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true

exec docker run --rm --gpus all --name "$CONTAINER_NAME" \
  "${VLLM_MOUNTS[@]}" "${VLLM_ENV[@]}" "${VLLM_ULIMITS[@]}" "${VLLM_NET[@]}" \
  -e VLLM_USE_V2_MODEL_RUNNER=1 \
  --ipc=host \
  "$IMAGE" \
  "$MODEL" \
  --served-model-name "$NAME" \
  --host 127.0.0.1 --port "$PORT" \
  ${VLLM_SLEEP:+--enable-sleep-mode} \
  --quantization modelopt_fp4 \
  --trust-remote-code \
  --attention-backend TRITON_ATTN \
  --reasoning-parser gemma4 \
  "${EAGER_ARGS[@]}" \
  --max-model-len "$MAXLEN" \
  --max-num-seqs "${MAX_SEQS:-1}" \
  --gpu-memory-utilization "$GPU_UTIL" \
  --kv-cache-dtype "$KV_DTYPE" \
  --default-chat-template-kwargs '{"enable_thinking":false}' \
  "$@"
