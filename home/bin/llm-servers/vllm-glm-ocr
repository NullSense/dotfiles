#!/usr/bin/env bash
# vllm-glm-ocr — serve zai-org/GLM-OCR (0.9B bf16, native glm_ocr, OmniDocBench
# ~95.15) on vLLM as the Documents-pipeline OCR cascade 3rd-consensus engine
# (rarely reached). Prompt: "Text Recognition:" (per the zai-org model card).
#
# MTP spec-decode is OFF: it needs vLLM nightly + transformers>=5.0.0, which
# the current pin does not carry (see the pin-tier note below — re-check this
# note whenever the pin advances).
#
# max-model-len 16384 (raised from 12000 on 2026-08-14, see git history of the
# config.yaml entry this replaces): ocr_http.py sends ONE request per page
# with max_tokens=10240; a page costs ~1344 vision tokens + prompt + 10240
# output ≈ 11.6k against a 12000 ceiling — too tight. limit-mm-per-prompt
# image:1 matches the 3721-token single-image encoder ceiling.
#
# Migrated 2026-08-15 from an inline `docker run` in llama-swap/config.yaml to
# a real wrapper (Fix 2 of the model-serving cleanup) — see vllm-paddleocr-vl
# for the full rationale (shared torch.compile cache, ulimits, host net).
# Relocation, not a retune: every flag+value is copied verbatim from the
# config.yaml entry it replaces.
#
# llama-swap-MANAGED, dynamic port (env PORT=${PORT}); PORT=8011 for manual runs.
set -euo pipefail
: "${PORT:=8011}"

MODEL="${MODEL:-zai-org/GLM-OCR}"
NAME="${SERVED_NAME:-glm-ocr}"
source "$(dirname "$(readlink -f "$0")")/_vllm-image.sh"  # central pin (vllm-update bumps it)
# REJOINED the leading tier 2026-09-12: was HELD 2026-08-15..2026-09-12 for a
# v0.27.1 KV-cache-too-small ValueError at the old GPU_UTIL=0.15 default. Measured
# on v0.29.0 (see _vllm-image.sh for the full GPU_UTIL sweep): 0.15/0.16 still fail
# the same way, 0.17 boots but leaves only ~272 tokens of margin above the
# single-request floor, 0.18 boots with real margin (21,872-token KV pool, 1.33x
# concurrency at max-model-len 16384) and matches paddleocr-vl's own 0.18 —
# verified past boot with a real page image + the model-card prompt returning
# plausible German OCR text, not the degenerate "!!!!..." output.
IMAGE="${VLLM_IMAGE:-$VLLM_IMAGE_PIN}"
MAXLEN="${MAXLEN:-16384}"
MAX_BATCHED="${MAX_BATCHED:-8192}"
GPU_UTIL="${GPU_UTIL:-0.18}"   # ×32GB ≈ 5.66 GB reserved (measured 2026-09-12 on v0.29.0; was 0.15/~4.8GB under the old HELD pin)

VLLM_HOST_NET=1                 # loopback-only, skips docker-proxy — see _vllm-common.sh
source "$(dirname "$(readlink -f "$0")")/_vllm-common.sh"

# Overridable so a smoke test / bench can run its OWN container instead of
# killing the live llama-swap one that shares this name.
: "${CONTAINER_NAME:=vllm-glm-ocr}"

docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true

exec docker run --rm --init --gpus all --name "$CONTAINER_NAME" \
  "${VLLM_MOUNTS[@]}" "${VLLM_ENV[@]}" "${VLLM_ULIMITS[@]}" "${VLLM_NET[@]}" \
  --ipc=host \
  "$IMAGE" \
  "$MODEL" \
  --served-model-name "$NAME" \
  --host 127.0.0.1 --port "$PORT" \
  --max-model-len "$MAXLEN" \
  --max-num-batched-tokens "$MAX_BATCHED" \
  --limit-mm-per-prompt '{"image":1}' \
  --gpu-memory-utilization "$GPU_UTIL" \
  --mm-processor-cache-gb 0 \
  "$@"
