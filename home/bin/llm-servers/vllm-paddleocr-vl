#!/usr/bin/env bash
# vllm-paddleocr-vl — serve PaddlePaddle/PaddleOCR-VL-1.6 (0.9B bf16, SOTA
# OmniDocBench 96.33) on vLLM as the Documents-pipeline OCR cascade PRIMARY
# engine. Prompt: "OCR:".
#
# Migrated 2026-08-15 from an inline `docker run` in llama-swap/config.yaml to
# a real wrapper (Fix 2 of the model-serving cleanup): the inline form had a
# hand-maintained literal image pin invisible to vllm-update's glob
# ($SERVERS/vllm-*), and missed _vllm-common.sh entirely — no shared
# torch.compile/FP4-autotune cache mount, no NVIDIA-recommended ulimits, and
# no VLLM_HOST_NET (so it paid the docker-proxy userspace relay). This is a
# relocation, not a retune: every flag+value below is copied verbatim from
# the config.yaml entry it replaces.
#
# llama-swap-MANAGED, dynamic port (env PORT=${PORT}); PORT=8010 for manual runs.
set -euo pipefail
: "${PORT:=8010}"

MODEL="${MODEL:-PaddlePaddle/PaddleOCR-VL-1.6}"
NAME="${SERVED_NAME:-paddleocr-vl}"
source "$(dirname "$(readlink -f "$0")")/_vllm-image.sh"  # central pin (vllm-update bumps it)
# Verified 2026-08-15 (boot test): serves correctly on the leading pin.
IMAGE="${VLLM_IMAGE:-$VLLM_IMAGE_PIN}"
MAXLEN="${MAXLEN:-16384}"
MAX_BATCHED="${MAX_BATCHED:-8192}"
GPU_UTIL="${GPU_UTIL:-0.18}"   # ×32GB ≈ 5.76 GB reserved (matches the prior inline entry)

VLLM_HOST_NET=1                 # loopback-only, skips docker-proxy — see _vllm-common.sh
source "$(dirname "$(readlink -f "$0")")/_vllm-common.sh"

# Overridable so a smoke test / bench can run its OWN container instead of
# killing the live llama-swap one that shares this name.
: "${CONTAINER_NAME:=vllm-paddleocr-vl}"

docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true

exec docker run --rm --init --gpus all --name "$CONTAINER_NAME" \
  "${VLLM_MOUNTS[@]}" "${VLLM_ENV[@]}" "${VLLM_ULIMITS[@]}" "${VLLM_NET[@]}" \
  --ipc=host \
  "$IMAGE" \
  "$MODEL" \
  --served-model-name "$NAME" \
  --host 127.0.0.1 --port "$PORT" \
  --trust-remote-code \
  --max-model-len "$MAXLEN" \
  --max-num-batched-tokens "$MAX_BATCHED" \
  --no-enable-prefix-caching \
  --gpu-memory-utilization "$GPU_UTIL" \
  --mm-processor-cache-gb 0 \
  "$@"
