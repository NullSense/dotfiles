#!/usr/bin/env python3
"""Notify when sccache's Rust hit rate drops, or when the setup drifts in a way
that makes it drop.

Each run checks:
  - the server answers `sccache --show-stats`;
  - the server's version equals /usr/bin/sccache's (the client cargo runs);
  - the cache is not pinned at its cap (eviction turns hits into misses);
  - the Rust hit rate over the window since the last evaluated sample.

The window keeps growing until it holds SCCACHE_HITRATE_MIN_REQUESTS Rust
compiles, so quiet periods never produce a verdict from a handful of crates.
A server restart resets sccache's counters; the window then restarts too.

Expected cold windows: a new rustc toolchain, a new sccache release, or a
change to the wrapper's key inputs all start from an empty cache for the
affected keys. One low window right after such a change is normal.
"""

import json
import os
import subprocess
import sys
from pathlib import Path

SCCACHE = "/usr/bin/sccache"
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "sccache-hitrate/baseline.json"
MIN_REQUESTS = int(os.environ.get("SCCACHE_HITRATE_MIN_REQUESTS", "300"))
THRESHOLD = float(os.environ.get("SCCACHE_HITRATE_THRESHOLD", "0.5"))
FULL_RATIO = 0.95


def notify(summary: str, body: str) -> None:
    print(f"sccache-hitrate-check: {summary}: {body}")
    subprocess.run(
        ["notify-send", "--app-name=sccache", "--urgency=critical", "--icon=dialog-warning", summary, body],
        check=False,
    )


def rust_counts(stats: dict) -> tuple[int, int]:
    hits = stats["cache_hits"]["counts"].get("Rust", 0)
    misses = stats["cache_misses"]["counts"].get("Rust", 0)
    return hits, misses


def main() -> int:
    result = subprocess.run([SCCACHE, "--show-stats", "--stats-format", "json"], capture_output=True, text=True)
    if result.returncode != 0:
        notify("sccache server unreachable", result.stderr.strip() or "show-stats failed")
        return 1
    report = json.loads(result.stdout)
    stats = report["stats"]

    client_version = subprocess.run([SCCACHE, "--version"], capture_output=True, text=True, check=True).stdout.split()[-1]
    if report["version"] != client_version:
        notify(
            "sccache version skew",
            f"server {report['version']} vs client {client_version}: systemctl --user restart sccache.service",
        )

    # cache_size is null until a freshly started server finishes sizing its dir.
    if report["cache_size"] is not None and report["cache_size"] >= FULL_RATIO * report["max_cache_size"]:
        notify(
            "sccache cache at its cap",
            f"{report['cache_size'] / 2**30:.0f} of {report['max_cache_size'] / 2**30:.0f} GiB: "
            "LRU eviction is dropping entries; check what grew before raising SCCACHE_CACHE_SIZE",
        )

    hits, misses = rust_counts(stats)
    not_cached = stats.get("not_cached", {})
    baseline = json.loads(STATE.read_text()) if STATE.exists() else None
    if baseline is None:
        STATE.parent.mkdir(parents=True, exist_ok=True)
        STATE.write_text(json.dumps({"hits": hits, "misses": misses, "not_cached": not_cached}))
        print(f"sccache-hitrate-check: baseline initialized at {hits} hits / {misses} misses")
        return 0
    if hits < baseline["hits"] or misses < baseline["misses"]:
        baseline = {"hits": 0, "misses": 0, "not_cached": {}}

    window_hits = hits - baseline["hits"]
    window_misses = misses - baseline["misses"]
    requests = window_hits + window_misses
    if requests < MIN_REQUESTS:
        print(f"sccache-hitrate-check: collecting, {requests}/{MIN_REQUESTS} Rust compiles in window")
        return 0

    rate = window_hits / requests
    print(f"sccache-hitrate-check: Rust hit rate {rate:.1%} ({window_hits}/{requests})")
    if rate < THRESHOLD:
        grown = {
            reason: count - baseline["not_cached"].get(reason, 0)
            for reason, count in not_cached.items()
            if count > baseline["not_cached"].get(reason, 0)
        }
        top = ", ".join(f"{reason} {count}" for reason, count in sorted(grown.items(), key=lambda kv: -kv[1])[:3])
        notify(
            f"sccache Rust hit rate {rate:.0%}",
            f"{window_hits}/{requests} hits since last check (threshold {THRESHOLD:.0%}). "
            f"Non-cacheable: {top or 'none'}. Likely: toolchain or sccache bump (normal once), "
            "or a new CARGO_* variable reaching rustc (see ~/.local/libexec/sccache-cargo/sccache).",
        )
    STATE.write_text(json.dumps({"hits": hits, "misses": misses, "not_cached": not_cached}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
