#!/usr/bin/env bash
# Screen recording via gpu-screen-recorder — Omarchy's flow, adapted.
#
# This is the SINGLE recording implementation for the box. Both entry points
# route here:
#   - Keybinds (SUPER+ALT+r etc.)      → ~/bin/screenrecord directly
#   - Elephant menu → omarchy-menu     → omarchy-capture-screenrecording, which
#                                         is shimmed to this script via ~/bin
#                                         (PATH shadows omarchy's own copy).
# Keeping one implementation means region-select, the privacy dot, and the
# start notification behave identically no matter how recording was launched.
#
# Behavior:
#   - First invocation:  pick monitor or region with slurp (same UX as the
#                        screenshot tool), start recording. Saves to
#                        ~/Videos/screenrecording-TIMESTAMP.mp4
#   - Second invocation: stops only this recorder, copies the file for paste,
#                        offers sharing/size presets in the notification.
#
# Args (optional, can combine):
#   --with-desktop-audio        record system audio
#   --with-microphone-audio     record mic
#   --with-webcam               overlay a floating webcam preview (ffplay)
#   --webcam-device=/dev/videoN pick the webcam (auto-detects first if omitted)
#   --resolution=WxH            cap resolution
#   --preset=share|small|native  default share = 1080p30; small = 720p30
#   --share-last                copy/compress the last finished recording
#   --stop-recording            stop if recording, else no-op (menu probe)
#   --game                      toggle 4K60 AV1 HDR recording of DP-1 + game audio
#   --replay                    toggle a 120-second HDR replay buffer in RAM
#   --save-replay               save the current replay without stopping capture
#
# Privacy dot:
#   gpu-screen-recorder captures via DRM/KMS, which PipeWire never sees — so the
#   privacy-dots backend can't light the "screen" dot for our own recordings.
#   Instead, waybar's xt3-status.sh lights the dot whenever a gpu-screen-recorder
#   process is alive, and we fire `pkill -RTMIN+15 waybar` on start/stop so it
#   flips instantly. This is why portal mode is no longer needed for the dot.
#
# Requirements (install via paru if missing):
#   - gpu-screen-recorder       (AUR; hardware-accelerated capture)
#   - hyprpicker, slurp, grim   (already on the box)
#   - ffmpeg, jq                (already on the box)
#   - v4l2-ctl, ffplay          (only for --with-webcam)

set -uo pipefail

if [[ ${1:-} == --share-last ]]; then
    exec "$HOME/bin/screenrecord-share" --menu
elif [[ ${1:-} == --toggle-pause ]]; then
    exec "$HOME/bin/screenrecord-status" --toggle-pause
fi

if ! command -v gpu-screen-recorder >/dev/null 2>&1; then
    notify-send -u critical "Screen recording" \
        "gpu-screen-recorder not installed. Run:  paru -S gpu-screen-recorder"
    exit 1
fi

# shellcheck source=/dev/null
[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="${SCREENRECORD_OUTPUT_DIR:-${XDG_VIDEOS_DIR:-$HOME/Videos}}"
mkdir -p "$OUTPUT_DIR"

DESKTOP_AUDIO=false
MIC_AUDIO=false
WEBCAM=false
WEBCAM_DEVICE=""
RESOLUTION=""
STOP=false
FPS=30
PRESET=share
RUNTIME_DIR="${XDG_RUNTIME_DIR:?}/screenrecord"
mkdir -p "$RUNTIME_DIR"
RECORDING_FILE="$RUNTIME_DIR/current"
PID_FILE="$RUNTIME_DIR/pid"
GAME_ACTION=""
GAME_WORKER=""

for arg in "$@"; do
    case "$arg" in
        --with-desktop-audio)    DESKTOP_AUDIO=true ;;
        --with-microphone-audio) MIC_AUDIO=true ;;
        --with-webcam)           WEBCAM=true ;;
        --webcam-device=*)       WEBCAM_DEVICE="${arg#--webcam-device=}" ;;
        --resolution=*)          RESOLUTION="${arg#--resolution=}" ;;
        --preset=*)              PRESET="${arg#--preset=}" ;;
        --stop-recording)        STOP=true ;;
        --game)                  GAME_ACTION=record ;;
        --replay)                GAME_ACTION=replay ;;
        --save-replay)           GAME_ACTION=save ;;
        --game-worker=*)         GAME_WORKER="${arg#--game-worker=}" ;;
        *) printf 'Unknown recording option: %s\n' "$arg" >&2; exit 2 ;;
    esac
done

is_recording() { pgrep -f "^gpu-screen-recorder" >/dev/null; }
toggle_indicator() { pkill -RTMIN+15 waybar 2>/dev/null || true; }

# systemd owns the gameplay encoder PID and stops it with SIGINT, preserving
# the container. Never signal every recorder: desktop and gameplay controls
# must not accidentally terminate each other or an unrelated capture.
game_active() {
    systemctl --user is-active --quiet "screenrecord-game@$1.service"
}

game_error() {
    printf '%s\n' "$*" >&2
    notify-send -u critical "Gameplay recording" "$*"
    return 1
}

game_worker() {
    local mode=$1 monitor=DP-1 destination
    [[ $mode == record || $mode == replay ]] || return 2
    if ! hyprctl -j monitors | jq -e --arg monitor "$monitor" \
        'any(.[]; .name == $monitor and (.colorManagementPreset | startswith("hdr")))' >/dev/null; then
        game_error "Enable HDR on $monitor before starting HDR capture."
        return 1
    fi
    local args=(-w "$monitor" -s 3840x2160 -f 60 -fm cfr
        -k av1_hdr -encoder gpu -fallback-cpu-encoding no
        -c mkv -bm cbr -q 60000 -a default_output -ac opus)
    if [[ $mode == replay ]]; then
        destination="$OUTPUT_DIR/Gameplay/Replays"
        mkdir -p "$destination"
        args+=(-r 120 -replay-storage ram)
    else
        mkdir -p "$OUTPUT_DIR/Gameplay"
        destination="$OUTPUT_DIR/Gameplay/gameplay-$(date +'%Y-%m-%d_%H-%M-%S-%N').mkv"
    fi
    printf 'Gameplay capture: %s -> %s\n' "$mode" "$destination"
    toggle_indicator
    exec gpu-screen-recorder "${args[@]}" -o "$destination"
}

game_control() {
    local action=$1 unit other variable
    exec 9>"${XDG_RUNTIME_DIR:?}/screenrecord-game.lock"
    flock -n 9 || return 0
    if [[ $action == save ]]; then
        game_active replay || { game_error "Start replay capture with Super+Alt+F10 first."; return 1; }
        systemctl --user kill --kill-whom=main --signal=SIGUSR1 screenrecord-game@replay.service || return
        notify-send "Saving replay" "Last two minutes → Videos/Gameplay/Replays"
        return
    fi
    unit="screenrecord-game@$action.service"
    if game_active "$action"; then
        systemctl --user stop "$unit" || return
        toggle_indicator
        if [[ $action == replay ]]; then
            notify-send "Replay capture stopped" "Saved clips remain in Videos/Gameplay/Replays."
        else
            notify-send "Gameplay recording saved" "Videos/Gameplay"
        fi
        return
    fi
    other=record
    [[ $action == record ]] && other=replay
    if game_active "$other" || is_recording; then
        game_error "Another recording is active. Stop it before starting a different mode."
        return 1
    fi
    # Refresh only display/session names; never import the whole shell environment.
    local session_vars=()
    for variable in WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP HYPRLAND_INSTANCE_SIGNATURE; do
        [[ -v $variable ]] && session_vars+=("$variable")
    done
    if ((${#session_vars[@]})); then
        systemctl --user import-environment "${session_vars[@]}" || return
    fi
    systemctl --user start "$unit" || return
    sleep 1
    if ! game_active "$action"; then
        game_error "Capture failed. See: journalctl --user -u $unit"
        return 1
    fi
    toggle_indicator
    if [[ $action == replay ]]; then
        notify-send "HDR replay capture started" "4K60 · game audio · 120 seconds in RAM\nSave: Super+Alt+F11 · Stop: Super+Alt+F10"
    else
        notify-send "HDR gameplay recording started" "4K60 · game audio\nStop and save: Super+Alt+F9"
    fi
}

if [[ -n $GAME_WORKER ]]; then
    game_worker "$GAME_WORKER"
    exit $?
elif [[ -n $GAME_ACTION ]]; then
    game_control "$GAME_ACTION"
    exit $?
elif game_active record || game_active replay; then
    # The capture menu probes --stop-recording too. Consume it without invoking
    # the desktop recorder's historical global stop path.
    notify-send "Gameplay capture is active" "Use Super+Alt+F9 for recording or Super+Alt+F10 for replay."
    exit 0
fi

case "$PRESET" in
    share)  RESOLUTION=${RESOLUTION:-1920x1080}; QUALITY=high ;;
    small)  RESOLUTION=${RESOLUTION:-1280x720}; QUALITY=medium ;;
    native) RESOLUTION=${RESOLUTION:-0x0}; FPS=60; QUALITY=very_high ;;
    *) printf 'Unknown recording preset: %s\n' "$PRESET" >&2; exit 2 ;;
esac
[[ $RESOLUTION =~ ^[0-9]+x[0-9]+$ ]] || exit 2

# Serialize double presses, selection, start and stop. Children must not inherit
# the lock. Runtime state is private to the login session, never shared /tmp.
exec 9>"$RUNTIME_DIR/control.lock"
flock -n 9 || exit 0

desktop_active() {
    local pid file
    read -r pid 2>/dev/null < "$PID_FILE" || return 1
    read -r file 2>/dev/null < "$RECORDING_FILE" || return 1
    [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null &&
        grep -zFxq -- "$file" "/proc/$pid/cmdline" 2>/dev/null
}

# Floating webcam preview via ffplay (cropped to the right half + downscaled).
# Window title "WebcamOverlay" is matched by a Hyprland float rule and by cleanup.
start_webcam_overlay() {
    cleanup_webcam
    if [[ -z $WEBCAM_DEVICE ]]; then
        WEBCAM_DEVICE=$(v4l2-ctl --list-devices 2>/dev/null | grep -m1 "^[[:space:]]*/dev/video" | tr -d '\t')
        if [[ -z $WEBCAM_DEVICE ]]; then
            notify-send "No webcam devices found" -u critical -t 3000
            return 1
        fi
    fi
    local scale
    scale=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | .scale')
    local target_width
    target_width=$(awk "BEGIN {printf \"%.0f\", 360 * $scale}")
    local preferred_resolutions=("640x360" "1280x720" "1920x1080")
    local video_size_arg=""
    local available_formats
    available_formats=$(v4l2-ctl --list-formats-ext -d "$WEBCAM_DEVICE" 2>/dev/null)
    for resolution in "${preferred_resolutions[@]}"; do
        if echo "$available_formats" | grep -q "$resolution"; then
            video_size_arg="-video_size $resolution"
            break
        fi
    done
    # shellcheck disable=SC2086
    ffplay -f v4l2 $video_size_arg -framerate 30 "$WEBCAM_DEVICE" \
        -vf "crop=iw/2:ih,scale=${target_width}:-1" \
        -window_title "WebcamOverlay" -noborder \
        -fflags nobuffer -flags low_delay -probesize 32 -analyzeduration 0 \
        -loglevel quiet 9>&- &
    sleep 1
}

cleanup_webcam() { pkill -f "WebcamOverlay" 2>/dev/null; }

get_rectangles() {
    local monitors ws sws
    monitors=$(hyprctl monitors -j)
    ws=$(jq -r '.[] | select(.focused) | .activeWorkspace.id' <<<"$monitors")
    sws=$(jq -r '.[] | select(.focused) | .specialWorkspace.id // 0' <<<"$monitors")
    jq -r --arg ws "$ws" '.[] | select(.activeWorkspace.id == ($ws | tonumber)) |
        (.width / .scale | floor) as $w | (.height / .scale | floor) as $h |
        if (.transform % 2) == 1 then "\(.x),\(.y) \($h)x\($w)"
        else "\(.x),\(.y) \($w)x\($h)" end' <<<"$monitors"
    hyprctl clients -j | jq -r --arg ws "$ws" --arg sws "$sws" '.[] |
        select(.workspace.id == ($ws | tonumber) or (($sws | tonumber) != 0 and .workspace.id == ($sws | tonumber))) |
        "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"'
}

select_target() {
    local rects sel mon
    rects=$(get_rectangles) || return 1
    hyprpicker -r -z >/dev/null 2>&1 &
    local pid=$!
    sleep 0.1
    sel=$(echo "$rects" | slurp 2>/dev/null)
    kill "$pid" 2>/dev/null

    [[ $sel =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]] || return 1
    local sx=${BASH_REMATCH[1]} sy=${BASH_REMATCH[2]} sw=${BASH_REMATCH[3]} sh=${BASH_REMATCH[4]}

    # Tiny click → snap to underlying rectangle
    if (( sw * sh < 20 )); then
        while IFS= read -r r; do
            [[ $r =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]] || continue
            local rx=${BASH_REMATCH[1]} ry=${BASH_REMATCH[2]} rw=${BASH_REMATCH[3]} rh=${BASH_REMATCH[4]}
            if (( sx >= rx && sx < rx+rw && sy >= ry && sy < ry+rh )); then
                sx=$rx sy=$ry sw=$rw sh=$rh; break
            fi
        done <<<"$rects"
    fi

    # Exact-monitor match → use -w MONITORNAME for native res, no scaling
    mon=$(hyprctl monitors -j | jq -r --argjson x "$sx" --argjson y "$sy" --argjson w "$sw" --argjson h "$sh" '
        .[] | (if (.transform % 2) == 1 then [.height, .width] else [.width, .height] end) as $size |
        select(.x == $x and .y == $y and ($size[0] / .scale | floor) == $w and ($size[1] / .scale | floor) == $h) | .name' | head -1)
    if [[ -n $mon ]]; then echo "monitor:$mon"; else echo "region:${sw}x${sh}+${sx}+${sy}"; fi
}

# Human-readable summary for the start notification.
audio_label() {
    if [[ $DESKTOP_AUDIO == true && $MIC_AUDIO == true ]]; then echo "Desktop + Microphone"
    elif [[ $DESKTOP_AUDIO == true ]]; then echo "Desktop"
    elif [[ $MIC_AUDIO == true ]]; then echo "Microphone"
    else echo "None (muted)"; fi
}

target_label() {
    case $1 in
        monitor:*) echo "Monitor ${1#monitor:} (full)" ;;
        region:*)  echo "Region ${1#region:}" | sed -E 's/\+.*$//' ;;
        *)         echo "$1" ;;
    esac
}

start_recording() {
    local target
    target=$(select_target) || return 1   # user cancelled slurp → no notification

    local capture_args=()
    local res_label source_width source_height cap_width cap_height
    case $target in
        monitor:*)
            res_label="$RESOLUTION"
            capture_args=(-w "${target#monitor:}")
            read -r source_width source_height < <(hyprctl monitors -j | jq -r --arg name "${target#monitor:}" '
                .[] | select(.name == $name) |
                if (.transform % 2) == 1 then "\(.height) \(.width)" else "\(.width) \(.height)" end') ;;
        region:*)
            capture_args=(-w "${target#region:}")
            [[ ${target#region:} =~ ^([0-9]+)x([0-9]+)\+(-?[0-9]+)\+(-?[0-9]+)$ ]] || return 1
            # Slurp uses logical pixels; KMS regions include the output scale.
            read -r source_width source_height < <(hyprctl monitors -j | jq -r \
                --argjson w "${BASH_REMATCH[1]}" --argjson h "${BASH_REMATCH[2]}" \
                --argjson x "${BASH_REMATCH[3]}" --argjson y "${BASH_REMATCH[4]}" '
                ([.[] | (.width / .scale) as $mw | (.height / .scale) as $mh |
                  (if (.transform % 2) == 1 then [$mh,$mw] else [$mw,$mh] end) as $size |
                  select($x >= .x and $x < .x + $size[0] and $y >= .y and $y < .y + $size[1]) |
                  .scale][0] // 1) as $scale | "\($w * $scale | floor) \($h * $scale | floor)"')
            res_label="$RESOLUTION" ;;
    esac
    # GSR's -s scales UP small regions too. Apply it only if a downscale is
    # needed; small snippets keep their original pixels and bitrate footprint.
    IFS=x read -r cap_width cap_height <<<"$RESOLUTION"
    if (( cap_width > 0 && cap_height > 0 && (source_width > cap_width || source_height > cap_height) )); then
        capture_args+=(-s "$RESOLUTION")
    else
        res_label=native
    fi
    [[ $res_label == "0x0" ]] && res_label="native"

    local audio_devs=""
    [[ $DESKTOP_AUDIO == true ]] && audio_devs="default_output"
    if [[ $MIC_AUDIO == true ]]; then
        [[ -n $audio_devs ]] && audio_devs+="|"
        audio_devs+="default_input"
    fi
    local audio_args=()
    [[ -n $audio_devs ]] && audio_args=(-a "$audio_devs" -ac aac -ab 128)

    [[ $WEBCAM == true ]] && start_webcam_overlay

    local file
    file="$OUTPUT_DIR/screenrecording-$(date +'%Y-%m-%d_%H-%M-%S-%N').mp4"
    gpu-screen-recorder "${capture_args[@]}" -k h264 -q "$QUALITY" -f "$FPS" -fm cfr \
        -c mp4 -ffmpeg-opts movflags=+faststart-hybrid_fragmented -exclude-metadata yes \
        -ipc "$RUNTIME_DIR/ipc.sock" -encoder gpu -fallback-cpu-encoding no \
        -o "$file" "${audio_args[@]}" >"$RUNTIME_DIR/encoder.log" 2>&1 9>&- &
    local pid=$!
    printf '%s\n' "$file" > "$RECORDING_FILE"
    printf '%s\n' "$pid" > "$PID_FILE"

    # Wait until file actually appears (gsr opens it lazily)
    local attempts=0
    while kill -0 "$pid" 2>/dev/null && [[ ! -f $file ]] && (( attempts < 100 )); do
        sleep 0.1; attempts=$((attempts+1))
    done
    if kill -0 "$pid" 2>/dev/null && [[ -f $file ]]; then
        "$HOME/bin/screenrecord-status" --started
        toggle_indicator
        local body
        body="Capture:  $(target_label "$target")"$'\n'
        body+="Audio:    $(audio_label)"$'\n'
        body+="Quality:  ${res_label} · ${FPS} fps"
        [[ $WEBCAM == true ]] && body+=$'\n'"Webcam:   on"
        body+=$'\n'"File:     $(basename "$file")"$'\n'
        body+=$'\n'"⏹  Stop: Super+Alt+R  ·  or Menu → Screenrecord"
        notify-send -t 8000 -u normal -i media-record "  Recording started" "$body"
    else
        # gsr died before opening the file (e.g. encoder/capture failure)
        kill -INT "$pid" 2>/dev/null || true
        cleanup_webcam
        notify-send -u critical -t 5000 "Screen recording" \
            "Failed to start. Details: $RUNTIME_DIR/encoder.log"
        return 1
    fi
}

stop_recording() {
    local pid f n=0
    read -r pid < "$PID_FILE"
    read -r f < "$RECORDING_FILE"
    "$HOME/bin/screenrecord-status" --finishing
    kill -INT "$pid" || return 1
    while desktop_active && (( n < 300 )); do
        sleep 0.1; n=$((n+1))
    done
    if desktop_active; then
        notify-send -u critical "Recording still finishing" "Try Stop again. Encoder log: $RUNTIME_DIR/encoder.log"
        return 1
    fi

    cleanup_webcam
    toggle_indicator
    # GSR finalized faststart MP4 itself; no full-file rewrite, audio encode,
    # lossy keyframe trim or thumbnail generation on the stop-to-paste path.
    : > "$PID_FILE"
    : > "$RECORDING_FILE"
    if ! "$HOME/bin/screenrecord-share" --saved "$f"; then
        notify-send -u critical "Recording needs attention" "File kept at $f; check validity or clipboard availability."
        return 1
    fi

    (
        ACTION=$(notify-send "Recording saved · copied" "Paste file · $(du -h "$f" | cut -f1) · click for sharing presets" -t 12000 \
            -i video-x-generic -A "default=Share / resize" -A "open=Play")
        case $ACTION in
            default) "$HOME/bin/screenrecord-share" --menu "$f" ;;
            open) xdg-open "$f" ;;
        esac
    ) 9>&- </dev/null >/dev/null 2>&1 &
}

if desktop_active; then
    stop_recording
elif [[ $STOP == true ]]; then
    exit 1
elif is_recording; then
    notify-send "Another recording is active" "Stop it with the control that started it."
    exit 1
else
    start_recording
fi
