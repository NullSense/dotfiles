#!/usr/bin/env python3
"""Desktop recording clipboard and exports; called by screenrecord and capture menu."""
import argparse
import datetime
import json
import math
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import textwrap


# Checked 2026-10-16. These are conservative export budgets, not advertised
# service limits. See CHAT-ATTACHMENT-LIMITS.md for primary sources/caveats.
APP_PRESETS = {
    "discord-free": ("Discord · Free (20 MB)", 19, 1080),
    "discord-basic": ("Discord · Nitro Basic / server level 2 (50 MB)", 47, 1080),
    "discord-server3": ("Discord · Server level 3 (100 MB)", 95, 1080),
    "discord-nitro": ("Discord · Nitro (1 GB)", 950, 1080),
    "signal": ("Signal · 95 MB safe target (remote limit may vary)", 95, 1080),
    "whatsapp-video": ("WhatsApp · Video (slow connection safe)", 60, 480),
    "whatsapp-file": ("WhatsApp · Document (2 GB)", 1900, 1080),
    "telegram": ("Telegram · Free (2 GB)", 1900, 1080),
    "telegram-premium": ("Telegram · Premium (4 GB)", 3800, 1080),
    "slack": ("Slack · File (1 GB)", 950, 1080),
    "teams": ("Teams · Chat attachment (100 MB)", 95, 1080),
}


def run(args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def notify(title, body):
    subprocess.run(["notify-send", title, body], check=False)


def latest_path():
    return Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "screenrecord/latest"


def probe(path):
    data = json.loads(run(["ffprobe", "-v", "error", "-show_format", "-show_streams",
                           "-of", "json", str(path)], capture_output=True, text=True).stdout)
    video = next(s for s in data["streams"] if s["codec_type"] == "video")
    video["_audio_codecs"] = [s.get("codec_name") for s in data["streams"] if s["codec_type"] == "audio"]
    duration = float(data["format"]["duration"])
    if not math.isfinite(duration) or duration <= 0:
        raise ValueError("Recording has no playable duration")
    return duration, video, any(s["codec_type"] == "audio" for s in data["streams"])


def copy_file(path):
    # A URI is tiny even for a multi-GB recording. Percent-encoding preserves
    # spaces, Unicode and #; file-aware applications request the actual file.
    path = path.resolve(strict=True)
    run(["wl-copy", "--type", "text/uri-list"], input=(path.as_uri() + "\r\n").encode())


def saved(path):
    probe(path)  # Never advertise a partial/corrupt MP4 as successfully saved.
    state = latest_path()
    state.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", dir=state.parent, delete=False) as f:
        f.write(str(path.resolve()))
    os.replace(f.name, state)


def metadata(path, *, title="", tags=(), caption="", start=0, end=None, mute=False, app=None):
    """Local sidecar; only the MP4 itself enters the clipboard."""
    value = {"version": 1, "title": title, "tags": list(tags), "caption": caption,
             "start_s": start, "end_s": end, "muted": mute, "app_preset": app,
             "exported_at": datetime.datetime.now(datetime.timezone.utc).isoformat()}
    sidecar = path.with_suffix(".capture.json")
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as f:
        json.dump(value, f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.replace(f.name, sidecar)


def encode(args, cwd, cancel_event=None):
    if cancel_event is None:
        return run(args, cwd=cwd)
    process = subprocess.Popen(args, cwd=cwd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    try:
        while True:
            if cancel_event.is_set():
                raise InterruptedError("Export cancelled; original preserved")
            try:
                _, errors = process.communicate(timeout=.2)
                if process.returncode:
                    raise OSError(errors.decode(errors="replace")[-3000:] or "FFmpeg export failed")
                return
            except subprocess.TimeoutExpired:
                pass
    finally:
        if process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=3)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()


def check_cancel(cancel_event):
    if cancel_event is not None and cancel_event.is_set():
        raise InterruptedError("Export cancelled; original preserved")


def export(path, preset="balanced", target_mb=None, *, app=None, start=0, end=None, mute=False,
           caption="", title="", tags=(), output_dir=None, copy=True, cancel_event=None):
    path = path.resolve(strict=True)
    duration, video, audio = probe(path)
    if video.get("color_transfer") in ("smpte2084", "arib-std-b67"):
        raise ValueError("HDR clips need tone mapping; these presets are for desktop SDR recordings")
    end = duration if end is None else end
    if not all(math.isfinite(x) for x in (start, end)) or not 0 <= start < end <= duration + .05:
        raise ValueError("Trim must have 0 ≤ start < end ≤ recording duration")
    end = min(end, duration)
    trimmed_duration = end - start
    if len(caption) > 500 or len(title) > 120:
        raise ValueError("Use at most 500 caption characters and 120 title characters")
    tags = list(dict.fromkeys(str(tag).strip() for tag in tags if str(tag).strip()))
    if len(tags) > 30 or any(len(tag) > 80 for tag in tags):
        raise ValueError("Use at most 30 tags, each up to 80 characters")
    app_height = 1440
    if app is not None:
        _, app_limit, app_height = APP_PRESETS[app]
        target_mb = min(target_mb, app_limit) if target_mb is not None else app_limit
    limit = None
    if target_mb is not None:
        if not math.isfinite(target_mb) or not 0.1 <= target_mb <= 4000:
            raise ValueError("Choose a size from 0.1 to 4000 MB")
        limit = int(target_mb * 1_000_000)  # Decimal MB, matching upload limits.
    height, quality = {"small": (720, 27), "balanced": (1080, 23), "clear": (1440, 20)}[preset]
    height = min(height, app_height)
    edits = start != 0 or end < duration - .01 or mute or bool(caption) or output_dir is not None
    if limit and not edits:
        if (path.stat().st_size <= limit and video.get("codec_name") == "h264"
                and path.suffix.lower() == ".mp4" and video.get("height", 0) <= height
                and all(c == "aac" for c in video.get("_audio_codecs", []))):
            check_cancel(cancel_event)
            if title or tags:
                metadata(path, title=title, tags=tags, app=app)
            if copy:
                copy_file(path)
            return path
    duration = trimmed_duration
    audio = audio and not mute
    bitrate = None
    if limit:
        bitrate = min(24_000_000, int(limit * 8 * .94 / duration) - (96_000 if audio else 0))
        if bitrate < 32_000:
            raise ValueError("Size too small for this duration; choose a larger MB limit")
        # Tiny budgets need fewer pixels as well as fewer bits per second.
        height = min(height, 360 if bitrate < 250_000 else 480 if bitrate < 600_000
                     else 720 if bitrate < 1_500_000 else 1080)
    # Fit either orientation, preserve aspect ratio, never upscale, even sizes.
    width = height * 16 // 9
    vf = (f"scale_cuda=w='min(iw,{width})':h='min(ih,{height})':"
          "force_original_aspect_ratio=decrease:force_divisible_by=2:format=yuv420p,setsar=1,fps=30")
    label = app or (f"{target_mb:g}MB" if limit else preset)
    destination_dir = Path(output_dir).expanduser().resolve() if output_dir else path.parent / "Shared"
    destination_dir.mkdir(parents=True, exist_ok=True)
    cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "screenrecord"
    cache.mkdir(parents=True, exist_ok=True)
    notify("Preparing recording", f"{label} export · original preserved")
    # Isolated pass logs; a failed/cancelled export never leaves a final MP4.
    with tempfile.TemporaryDirectory(prefix="export-", dir=cache) as scratch:
        scratch = Path(scratch)
        if caption:
            ratio = min(1, width / max(2, video.get("width", width)), height / max(2, video.get("height", height)))
            out_w = max(2, int(video.get("width", width) * ratio))
            out_h = max(2, int(video.get("height", height) * ratio))
            fontsize = max(12, min(48, out_h // 24))
            columns = max(8, int((out_w - 24) / (fontsize * .65)))
            lines = "\n".join(textwrap.fill(line, width=columns) for line in caption.splitlines())
            if len(lines.splitlines()) * (fontsize + 4) > out_h - 24:
                raise ValueError("Caption is too long for this output resolution")
            (scratch / "caption.txt").write_text(lines, encoding="utf-8")
            # Only the caption overlay crosses to CPU; scaling stays CUDA and
            # encoding stays NVENC. User text is a file, never filter syntax.
            vf += (f",hwdownload,format=yuv420p,drawtext=textfile=caption.txt:expansion=none:"
                   f"fontsize={fontsize}:fontcolor=white:box=1:boxcolor=black@0.65:boxborderw=8:"
                   "x=(w-text_w)/2:y=h-text_h-20:fix_bounds=1,hwupload_cuda")
        output = scratch / "output.mp4"
        base = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-nostdin", "-y",
                "-hwaccel", "cuda", "-hwaccel_output_format", "cuda", "-ss", str(start), "-i", str(path),
                "-t", str(duration),
                "-map", "0:v:0", "-vf", vf, "-c:v", "h264_nvenc", "-preset", "p4", "-tune", "hq",
                "-rc", "vbr", "-multipass", "qres", "-spatial-aq", "1",
                "-filter_threads", "2", "-map_metadata", "-1"]
        tail = ["-map", "0:a:0?", "-c:a", "aac", "-b:a", "96k", "-ac", "2",
                "-movflags", "+faststart", str(output)]
        if mute:
            tail = ["-an", "-movflags", "+faststart", str(output)]
        if limit:
            # Reserve container overhead and AAC bandwidth, then verify bytes.
            # NVENC multipass VBR preserves the full duration (no -fs).
            for attempt in range(3):
                rate = ["-b:v", str(bitrate), "-maxrate", str(bitrate * 2), "-bufsize", str(bitrate * 2)]
                encode(base + rate + tail, scratch, cancel_event)
                size = output.stat().st_size
                if size <= limit:
                    break
                audio_bytes = 12_000 * duration if audio else 0
                bitrate = int(bitrate * max(0, limit * .94 - audio_bytes) / max(1, size - audio_bytes) * .9)
                if bitrate < 32_000:
                    raise ValueError("Cannot meet this size without losing audio or duration")
            else:
                raise ValueError("Export exceeded the limit; original preserved")
        else:
            encode(base + ["-cq", str(quality), "-b:v", "0"] + tail, scratch, cancel_event)
        result_duration, _, result_audio = probe(output)
        if abs(result_duration - duration) > max(.25, duration * .01):
            raise ValueError("Export duration changed; original preserved")
        if audio != result_audio:
            raise ValueError("Export audio did not match the mute setting")
        check_cancel(cancel_event)
        # Unique filename and atomic publication, including across filesystems.
        safe_title = "".join(c if c.isalnum() or c in " -_" else "-" for c in title).strip(" .-")[:80]
        with tempfile.NamedTemporaryFile(prefix=f"{safe_title or path.stem}-{label}-", suffix=".part",
                                         dir=destination_dir, delete=False) as f:
            staging = Path(f.name)
            destination = staging.with_suffix(".mp4")
        try:
            shutil.copyfile(output, staging)
            os.replace(staging, destination)
        finally:
            staging.unlink(missing_ok=True)
    metadata(destination, title=title, tags=tags, caption=caption, start=start, end=end, mute=mute, app=app)
    check_cancel(cancel_event)
    if copy:
        copy_file(destination)
        notify("Recording ready · copied", f"{destination.stat().st_size / 1_000_000:.2f} MB · {destination.name}")
    return destination


def menu(path):
    run([str(Path.home() / "bin/screenrecord-review"), str(path)])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    action = parser.add_mutually_exclusive_group()
    action.add_argument("--copy", action="store_true")
    action.add_argument("--saved", action="store_true")
    action.add_argument("--menu", action="store_true")
    parser.add_argument("--target-mb", type=float)
    parser.add_argument("--preset", choices=("small", "balanced", "clear"))
    parser.add_argument("--app", choices=APP_PRESETS)
    parser.add_argument("--start", type=float, default=0)
    parser.add_argument("--end", type=float)
    parser.add_argument("--mute", action="store_true")
    parser.add_argument("--caption", default="")
    parser.add_argument("--title", default="")
    parser.add_argument("--tags", default="", help="Comma-separated local tags")
    parser.add_argument("--output-dir", type=Path)
    parser.add_argument("--no-copy", action="store_true")
    parser.add_argument("file", nargs="?", type=Path)
    args = parser.parse_args()
    try:
        path = args.file or Path(latest_path().read_text())
        path = path.resolve(strict=True)
        if args.saved:
            saved(path)
        elif args.copy:
            copy_file(path)
        elif (args.target_mb is not None or args.preset or args.app or args.start or args.end is not None
              or args.mute or args.caption or args.title or args.tags or args.output_dir):
            print(export(path, preset=args.preset or "balanced", target_mb=args.target_mb, app=args.app,
                         start=args.start, end=args.end, mute=args.mute, caption=args.caption,
                         title=args.title, tags=args.tags.split(","), output_dir=args.output_dir,
                         copy=not args.no_copy))
        else:
            menu(path)
        return 0
    except (OSError, ValueError, KeyError, StopIteration, subprocess.CalledProcessError) as error:
        print(f"screenrecord-share: {error}", file=sys.stderr)
        notify("Recording sharing failed", str(error))
        return 1


if __name__ == "__main__":
    sys.exit(main())
