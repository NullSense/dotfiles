#!/usr/bin/env bash
# stack — bring up the whole local dev stack with one command.
#   observability :3000 — grafana/otel-lgtm (OTel collector + Tempo/Loki/Prometheus/Grafana)
#   llama-swap    :9292 — model swapper (loads/unloads models per-request via TTL)
#   litellm       :4000 — OpenAI gateway (logical names → local/cloud; traces → :4318 collector)
#   glance        :8088 — dashboard (systemd --user unit)
#   uptime-kuma   :3009 — uptime/SLA (docker container)
# llama-swap owns on-demand model lifecycle. Observability + dashboards are
# monitoring — `up` ensures them, `down` LEAVES them. See ~/notes/LLM-STACK.md.
#
# Secrets: litellm's cloud routes need OPENROUTER_API_KEY + LITELLM_MASTER_KEY, injected from
# Infisical via `infisical run` (NOT agent-vault — that's for agent tool-calls).
set -euo pipefail

LLMSTACK="${LLMSTACK:-$HOME/Programming/llm-stack}"   # central repo: composes, collector, benches
LSWAP_CFG="${LSWAP_CFG:-$HOME/.config/llama-swap/config.yaml}"
LITELLM_CFG="${LITELLM_CFG:-$HOME/.config/litellm/config.yaml}"
OBS_COMPOSE="${OBS_COMPOSE:-$LLMSTACK/stack/observability/docker-compose.yml}"
LANGFUSE_COMPOSE="${LANGFUSE_COMPOSE:-$LLMSTACK/stack/langfuse/docker-compose.yml}"
COLLECTOR_COMPOSE="${COLLECTOR_COMPOSE:-$LLMSTACK/stack/collector/docker-compose.yml}"
OWUI_COMPOSE="${OWUI_COMPOSE:-$LLMSTACK/stack/open-webui/docker-compose.yml}"
RUN="${RUN:-$HOME/.cache/llm-stack}"; mkdir -p "$RUN"

# up = got any HTTP code (401 from litellm still means "alive"); 000 = not listening.
is_up() { local c; c=$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "$1" 2>/dev/null || true); [ -n "$c" ] && [ "$c" != "000" ]; }
wait_tcp() { local h="${1%:*}" p="${1#*:}" i; for ((i = 0; i < ${2:-15}; i++)); do (exec 3<>"/dev/tcp/$h/$p") 2>/dev/null && { exec 3>&- 3<&-; return 0; }; sleep 1; done; return 1; }

# llama-swap v250 hot reload is not request-safe: both --watch-config and
# SIGHUP swap routers and immediately tear down the old one.  Read the
# authoritative in-flight snapshot before using systemd's normal SIGTERM path,
# which stops accepting new HTTP work and drains existing requests first.
llama_swap_is_idle() {
  local snapshot
  snapshot=$(
    { curl -sN --max-time 3 http://127.0.0.1:9292/api/events 2>/dev/null || true; } \
      | awk '/^data:.*"type":"inflight"/ { sub(/^data:/, ""); print; exit }'
  )
  [ -n "$snapshot" ] || return 1
  jq -e 'select(.type == "inflight") | .data | fromjson | ((.requests // []) | length == 0)' \
    >/dev/null <<<"$snapshot"
}

wait_llama_swap_idle() {
  local timeout="${1:-180}" i
  for ((i = 0; i < timeout; i++)); do
    llama_swap_is_idle && return 0
    sleep 1
  done
  echo "  ⚠ llama-swap still has an active request after ${timeout}s; refusing restart" >&2
  return 1
}

restart_llama_swap() {
  command -v yq >/dev/null 2>&1 || { echo "  ⚠ yq is required to validate $LSWAP_CFG" >&2; return 1; }
  yq '.' "$LSWAP_CFG" >/dev/null
  wait_llama_swap_idle "${LLAMA_SWAP_DRAIN_TIMEOUT:-180}"
  systemctl --user restart llama-swap
  wait_tcp 127.0.0.1:9292 15
  echo "  ↻ llama-swap restarted after the inference lane drained"
}

diagnostic_canary() {
  # Resolve only the scoped LiteLLM key inside the short-lived Python process;
  # never place it in argv, a temp file, or this shell's exported environment.
  STACK_CANARY_MODEL="${STACK_CANARY_MODEL:-qwen3.8-27b-nvfp4-long:fast}" \
    python3 - "$HOME/.local/libexec/hermes-secret-env" <<'PY'
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request

helper = subprocess.run(
    [sys.argv[1]], check=True, text=True, stdout=subprocess.PIPE,
    stderr=subprocess.PIPE, timeout=35,
)
key = next(
    (line.partition("=")[2] for line in helper.stdout.splitlines()
     if line.startswith("LITELLM_API_KEY=")),
    "",
)
if not key:
    raise SystemExit("stack canary: secret helper did not provide LITELLM_API_KEY")

model = os.environ["STACK_CANARY_MODEL"]
payload = json.dumps({
    "model": model,
    "messages": [{"role": "user", "content": "Reply exactly OK."}],
    "max_tokens": 8,
    "temperature": 0,
    "metadata": {"tags": ["client:stack", "role:diagnostic"]},
}).encode()
request = urllib.request.Request(
    "http://127.0.0.1:8787/v1/chat/completions",
    data=payload,
    headers={
        "Authorization": f"Bearer {key}",
        "Content-Type": "application/json",
        "x-litellm-tags": "client:stack,role:diagnostic",
    },
)
try:
    with urllib.request.urlopen(request, timeout=180) as response:
        data = json.load(response)
except urllib.error.HTTPError as exc:
    raise SystemExit(f"stack canary: HTTP {exc.code}: {exc.read(300).decode(errors='replace')}")

content = data.get("choices", [{}])[0].get("message", {}).get("content", "")
print(f"  ✓ Headroom → LiteLLM → {model}: {content.strip()[:80]}")
PY
}
kill_port() {  # kill whatever LISTENS on a TCP port — reliable, no fuser/pattern guessing
  local port="$1" pids
  pids=$(ss -tlnpH "sport = :$port" 2>/dev/null | grep -oP 'pid=\K[0-9]+' | sort -u)
  [ -n "$pids" ] || return 1
  # Deliberate word splitting: ss may return more than one PID.
  # shellcheck disable=SC2086
  kill $pids 2>/dev/null; sleep 1
  pids=$(ss -tlnpH "sport = :$port" 2>/dev/null | grep -oP 'pid=\K[0-9]+' | sort -u)
  # shellcheck disable=SC2086
  [ -n "$pids" ] && kill -9 $pids 2>/dev/null || true
  return 0
}

sweep_swap_children() {  # llama-swap spawns llama-server backends as its OWN children; `down`
  # kills only the :9292 listener (llama-swap itself), orphaning those children — they reparent
  # to systemd, keep pinning VRAM, and the next llama-swap can't see them (/running lies). Kill
  # the subtree FIRST, while llama-swap is alive so we can find them. A --rm model container can
  # outlive a reaped `docker run` client, so the `down` case also stops known legacy containers.
  local swap_pids p kids
  swap_pids=$(ss -tlnpH "sport = :9292" 2>/dev/null | grep -oP 'pid=\K[0-9]+' | sort -u)
  [ -n "$swap_pids" ] || swap_pids=$(pgrep -x llama-swap 2>/dev/null || true)
  for p in $swap_pids; do
    kids=$(pgrep -P "$p" 2>/dev/null || true)
    [ -n "$kids" ] || continue
    # Deliberate word splitting: a parent can have several children.
    # shellcheck disable=SC2086
    kill $kids 2>/dev/null || true; sleep 1
    kids=$(pgrep -P "$p" 2>/dev/null || true)
    # shellcheck disable=SC2086
    [ -n "$kids" ] && kill -9 $kids 2>/dev/null || true
  done
}

start_one() { # name  health-url  command...
  local name="$1" url="$2"; shift 2
  if is_up "$url"; then
    if [ -f "$RUN/$name.pid" ]; then echo "  • $name already up"
    else echo "  ⚠ $name's port is held by a process stack didn't start (likely a stray docker"
         echo "    container). Free it:  docker ps --filter publish=<port> -q | xargs -r docker stop"; fi
    return
  fi
  nohup "$@" >"$RUN/$name.log" 2>&1 &
  echo $! >"$RUN/$name.pid"
  echo "  ▶ $name started (pid $(cat "$RUN/$name.pid")) → log: $RUN/$name.log"
}

ensure_gateway_env() {  # THE SWITCH, systemd edition. litellm.service reads
  # ~/.config/litellm/gateway.env (EnvironmentFile) because a systemd unit can't see this
  # shell's exports. development=LOCAL (llama-swap, default) · production=CLOUD (OpenRouter).
  # Flip:  LITELLM_ENVIRONMENT=production stack restart
  local envf="$HOME/.config/litellm/gateway.env" want="${LITELLM_ENVIRONMENT:-development}" have=""
  [ -f "$envf" ] && have="$(sed -n 's/^LITELLM_ENVIRONMENT=//p' "$envf")"
  printf 'LITELLM_ENVIRONMENT=%s\n' "$want" > "$envf"
  echo "  • litellm environment: $want ($([ "$want" = production ] && echo 'CLOUD/OpenRouter' || echo 'LOCAL/llama-swap'))"
  if [ -n "$have" ] && [ "$have" != "$want" ] && systemctl --user is-active -q litellm; then
    systemctl --user restart litellm && echo "  ↻ litellm restarted (environment $have → $want)"
  fi
}

ensure_gateway_db() {  # ONLY litellm-db — the always-on bit the gateway needs. The rest of
  # observability (otel-lgtm + Langfuse + collector) is ~6 GB of RAM only needed while you're
  # actually inspecting traces, so it's off by default. Bring it up on demand with `stack obs`.
  command -v docker >/dev/null 2>&1 || { echo "  ⚠ docker not found — skipping gateway DB"; return; }
  docker network inspect llmstack >/dev/null 2>&1 || docker network create llmstack >/dev/null
  docker compose -f "$OBS_COMPOSE" up -d litellm-db >/dev/null 2>&1 \
    && echo "  ▶ gateway DB → litellm-db :5433  (obs off — run 'stack obs' for Grafana/Langfuse)" \
    || echo "  ⚠ litellm-db compose up failed"
}

ensure_obs() {  # FULL observability (Grafana/Tempo) + Langfuse + the collector that fans out to both
  command -v docker >/dev/null 2>&1 || { echo "  ⚠ docker not found — skipping observability"; return; }
  docker network inspect llmstack >/dev/null 2>&1 || docker network create llmstack >/dev/null
  docker compose -f "$OBS_COMPOSE" up -d >/dev/null 2>&1 \
    && echo "  ▶ observability → Grafana :3000 · Tempo :3200 · Prom :9090 · litellm-db :5433" \
    || echo "  ⚠ observability compose up failed"
  if [ -s "$(dirname "$LANGFUSE_COMPOSE")/.env" ]; then
    ( cd "$(dirname "$LANGFUSE_COMPOSE")" && docker compose --env-file .env up -d >/dev/null 2>&1 ) \
      && echo "  ▶ langfuse → http://localhost:3002 (LLM traces + eval datasets)" \
      || echo "  ⚠ langfuse compose up failed"
  else echo "  ⚠ langfuse .env missing — run: bash $LLMSTACK/stack/langfuse/gen-env.sh"; fi
  ( cd "$(dirname "$COLLECTOR_COMPOSE")" && docker compose --env-file ../langfuse/.env up -d >/dev/null 2>&1 ) \
    && echo "  ▶ otel-collector → OTLP :4317/:4318 → fans out to Tempo + Langfuse" \
    || echo "  ⚠ collector compose up failed"
}

ensure_dashboards() {
  if is_up http://127.0.0.1:8088/; then echo "  • glance already up"
  elif systemctl --user start glance 2>/dev/null; then echo "  ▶ glance → :8088 (systemd)"
  else start_one glance http://127.0.0.1:8088/ "$HOME/.local/bin/glance" --config "$HOME/.config/glance/glance.yml"; fi
  if is_up http://127.0.0.1:3009/; then echo "  • uptime-kuma already up"
  elif command -v docker >/dev/null 2>&1 && docker start uptime-kuma >/dev/null 2>&1; then echo "  ▶ uptime-kuma → :3009 (docker)"
  else echo "  ⚠ uptime-kuma not running (one-time: docker run -d --restart=unless-stopped -p 3009:3001 -v uptime-kuma:/app/data --name uptime-kuma louislam/uptime-kuma:1)"; fi
  # Open WebUI (chat front-end for the gateway). Retired 2026-07-09 — no longer used.
  # Opt back in with STACK_OWUI=1 (its compose still lives in stack/open-webui/).
  if [ "${STACK_OWUI:-0}" = "1" ]; then
    if is_up http://127.0.0.1:8090/; then echo "  • open-webui already up"
    elif [ -s "$(dirname "$OWUI_COMPOSE")/.env" ] && command -v docker >/dev/null 2>&1; then
      ( cd "$(dirname "$OWUI_COMPOSE")" && docker compose --env-file .env up -d >/dev/null 2>&1 ) \
        && echo "  ▶ open-webui → :8090 (docker · tailnet http://100.121.121.37:8090)" \
        || echo "  ⚠ open-webui failed to start (docker compose)"
    else echo "  ⚠ open-webui not started (missing stack/open-webui/.env or docker)"; fi
  fi
  # Refresh Glance's auto-discovered service cards (DRY: same ~/bin/discover-services the
  # Super+S picker uses). Glance hot-reloads on file change. Non-fatal.
  if [ -f "$HOME/Programming/llm-stack/stack/gen-glance-services.py" ]; then
    python3 "$HOME/Programming/llm-stack/stack/gen-glance-services.py" >/dev/null 2>&1 \
      && echo "  • glance service cards refreshed (auto-discovered)" || true
  fi
}

patch_litellm_prisma_client() {
  # LiteLLM 1.97.0 writes a replacement query engine through the removed
  # prisma-client-py private attribute `_Prisma__engine`. Prisma 0.15 exposes
  # the supported `_engine` property setter instead. Keep this narrowly gated:
  # one exact upstream line is repaired, an already-repaired/upstream-fixed
  # install is accepted, and every unknown layout fails closed.
  local client
  client=$(find "$HOME/.local/share/uv/tools/litellm" \
    -path '*/site-packages/litellm/proxy/db/prisma_client.py' -print -quit 2>/dev/null)
  [ -n "$client" ] || { echo "  ⚠ LiteLLM Prisma client not found"; return 1; }
  python3 - "$client" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
text = path.read_text()
broken = "prisma_client._Prisma__engine = engine"
fixed = "prisma_client._engine = engine"

if text.count(broken) == 1:
    path.write_text(text.replace(broken, fixed))
    print("  ✓ repaired LiteLLM 1.97.0 Prisma engine setter compatibility")
elif broken not in text and text.count(fixed) == 1:
    print("  • LiteLLM Prisma engine setter already compatible")
else:
    raise SystemExit("LiteLLM Prisma client layout is unknown; refusing to patch")
PY
}

sift_chat_preflight() {
  local config_contract minimum_headroom_mib running_snapshot gpu_snapshot free_mib model
  local -a expected_models missing_models free_values

  for tool in yq jq curl nvidia-smi; do
    command -v "$tool" >/dev/null 2>&1 \
      || { echo "  ⚠ sift-chat preflight requires $tool" >&2; return 1; }
  done
  [[ -r "$LSWAP_CFG" ]] \
    || { echo "  ⚠ sift-chat preflight cannot read $LSWAP_CFG" >&2; return 1; }

  config_contract=$(yq -e -c '
    select(.matrix.sets."sift-chat" == "A & n & x & m")
    | (.models."nanbeige-sift".metadata.sift_chat_capacity.minimum_headroom_mib) as $minimum
    | [.matrix.vars.A, .matrix.vars.n, .matrix.vars.x, .matrix.vars.m] as $models
    | select(($minimum | type) == "number"
        and ($minimum | floor) == $minimum
        and $minimum >= 0)
    | select(($models | unique | length) == 4
        and all($models[]; type == "string" and length > 0))
    | {minimum_headroom_mib: $minimum, models: $models}
  ' "$LSWAP_CFG") \
    || { echo "  ⚠ sift-chat config has no valid capacity contract" >&2; return 1; }
  minimum_headroom_mib=$(jq -r '.minimum_headroom_mib' <<<"$config_contract")
  mapfile -t expected_models < <(jq -r '.models[]' <<<"$config_contract")

  running_snapshot=$(curl --fail --silent --show-error --max-time 3 \
    http://127.0.0.1:9292/running) \
    || { echo '  ⚠ llama-swap /running is unavailable' >&2; return 1; }
  jq -e '(.running | type == "array") and all(.running[]; type == "string")' \
    >/dev/null <<<"$running_snapshot" \
    || { echo '  ⚠ llama-swap /running returned an invalid payload' >&2; return 1; }

  missing_models=()
  for model in "${expected_models[@]}"; do
    jq -e --arg model "$model" '.running | index($model) != null' \
      >/dev/null <<<"$running_snapshot" || missing_models+=("$model")
  done
  if ((${#missing_models[@]} != 0)); then
    printf '  ⚠ sift-chat providers are not co-resident: %s\n' \
      "${missing_models[*]}" >&2
    return 1
  fi

  gpu_snapshot=$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits) \
    || { echo '  ⚠ cannot read GPU memory headroom' >&2; return 1; }
  mapfile -t free_values <<<"$gpu_snapshot"
  ((${#free_values[@]} == 1)) \
    || { echo '  ⚠ sift-chat headroom is ambiguous across multiple GPUs' >&2; return 1; }
  free_mib=${free_values[0]//[[:space:]]/}
  [[ "$free_mib" =~ ^[0-9]+$ ]] \
    || { echo '  ⚠ GPU memory headroom is not a numeric MiB value' >&2; return 1; }
  ((free_mib >= minimum_headroom_mib)) \
    || { printf '  ⚠ sift-chat has %s MiB free; minimum is %s MiB\n' \
      "$free_mib" "$minimum_headroom_mib" >&2; return 1; }

  printf '  ✓ sift-chat preflight passed: %s/%s providers resident; %s MiB free (minimum %s MiB)\n' \
    "${#expected_models[@]}" "${#expected_models[@]}" "$free_mib" "$minimum_headroom_mib"
}

case "${1:-status}" in
  up)
    # Observability is ~6 GB and only needed to VIEW traces. It is deliberately
    # impossible for `stack up` to start it; `stack obs` is the sole opt-in path.
    ensure_gateway_db
    # llama-swap + litellm are SYSTEMD user units now (2026-07-22): enabled at login,
    # Restart=on-failure, cgroup kill = no orphans. The old nohup+pidfile scheme tracked
    # the `infisical run` wrapper PID — when it died, orphaned litellm children kept
    # :4000 and restarts raced "address already in use". Env (OTEL, Infisical,
    # agent-vault) lives in the ~/bin/llm-servers/litellm-* wrappers, not here.
    systemctl --user start llama-swap && echo "  ▶ llama-swap → :9292 (systemd)"
    wait_tcp 127.0.0.1:5433 15 && echo "  • gateway DB ready :5433" \
      || echo "  ⚠ litellm-db not ready — virtual keys (/key/generate) may fail until it is"
    ensure_gateway_env   # THE SWITCH → gateway.env (systemd can't see caller exports)
    systemctl --user start litellm && echo "  ▶ litellm gateway → :4000 (systemd · MCP-free profile, binds in seconds)"
    # Do not warm a model here. Hermes and hyprwhspr-ai share the resident Qwen 3.8 route;
    # warming the retired E4B rewrite path would evict or contend with that resident model.
    # Each real caller is responsible for selecting its current logical route on demand.
    # Dashboards (glance :8088 + uptime-kuma :3009) are monitoring, not serving → opt-in.
    # `STACK_DASH=1 stack up` (or run `stack dash`) brings them up. Keeps `stack up` minimal:
    # just the gateway + always-on light models; heavy/monitoring bits load on demand.
    if [ "${STACK_DASH:-0}" = 1 ]; then ensure_dashboards; fi
    echo "  stack up (minimal). gateway → :4000 · model router → :9292  (obs off: 'stack obs' · dashboards off: 'stack dash')"
    ;;
  dash) ensure_dashboards; echo "  dashboards up → glance :8088 · uptime-kuma :3009"; ;;
  gateway)  # JUST the litellm router (:4000) — NO models, 0 GB VRAM. It's a pure OpenAI proxy:
    # cloud routes (code→OpenRouter, and everything under LITELLM_ENVIRONMENT=production) + virtual-
    # key/config mgmt work immediately. Local logical names (summarize/rewrite→llama-swap :9292) 5xx
    # until you `stack up` their backends. Handy for config testing or cloud-only use. `stack down`
    # stops it. systemd-owned (litellm.service) — env in ~/bin/llm-servers/litellm-gateway.
    # Keep gateway startup independent from the heavy observability stack.
    ensure_gateway_db
    wait_tcp 127.0.0.1:5433 15 && echo "  • gateway DB ready :5433" \
      || echo "  ⚠ litellm-db not ready — virtual keys (/key/generate) may fail until it is"
    ensure_gateway_env
    systemctl --user start litellm && echo "  ▶ litellm gateway → :4000 (systemd)"
    echo "  gateway up → :4000 (no models · 'stack up' adds the on-demand llama-swap router)"
    ;;
  preflight)
    case "${2:-}" in
      sift-chat) sift_chat_preflight ;;
      *) echo 'usage: stack preflight sift-chat'; exit 1 ;;
    esac
    ;;
  mcp)  # OPTIONAL MCP-aggregation litellm instance (:4001, config-mcp.yaml). Slow to boot BY
    # NATURE (tool discovery across every MCP server before uvicorn binds) — which is exactly
    # why it's split from the always-on gateway. Consumers: claude-code `litellm` MCP client
    # → http://127.0.0.1:4001/mcp/ (trailing slash). `stack mcp off` stops it.
    case "${2:-on}" in
      on|start)
        systemctl --user start litellm-mcp \
          && echo "  ▶ litellm-mcp → :4001 (systemd · MCP aggregation; discovery takes a while — watch: journalctl --user -fu litellm-mcp)" \
          || echo "  ⚠ litellm-mcp failed to start"
        ;;
      off|stop) systemctl --user stop litellm-mcp && echo "  ■ litellm-mcp stopped (:4001)" ;;
      *) echo "usage: stack mcp [on|off]"; exit 1 ;;
    esac
    ;;
  down)  # stops the LLM serving stack only — leaves observability + dashboards monitoring
    sweep_swap_children   # reap llama-server backends BEFORE stopping llama-swap (else they orphan + pin VRAM)
    for u in litellm-mcp litellm llama-swap; do
      systemctl --user is-active -q "$u" && systemctl --user stop "$u" && echo "  ■ stopped $u (systemd)" || true
    done
    # stray/legacy listeners (pre-systemd nohup instances, manual runs): port-kill as fallback
    for entry in litellm:4000 litellm-mcp:4001 llama-swap:9292; do
      name="${entry%%:*}"; port="${entry##*:}"
      kill_port "$port" && echo "  ■ killed stray $name listener (:$port)" || true
      rm -f "$RUN/$name.pid"
    done
    # `rewrite` (E4B) is a llama-swap-managed vLLM CONTAINER (dynamic port, name vllm-gemma4b).
    # sweep_swap_children reaps llama-swap's `docker run` client, but a --rm container can outlive
    # that, so stop it explicitly here.
    if command -v docker >/dev/null 2>&1; then
      docker ps -q --filter name=vllm-gemma4b | grep -q . && docker rm -f vllm-gemma4b >/dev/null 2>&1 && echo "  ■ stopped vllm-gemma4b (rewrite)"
    fi
    echo "  (observability + dashboards left running — 'stack mon-down' to stop those too)"
    ;;
  mon-down)
    systemctl --user stop glance 2>/dev/null && echo "  ■ glance" || true
    if command -v docker >/dev/null 2>&1; then
      docker stop uptime-kuma >/dev/null 2>&1 && echo "  ■ uptime-kuma" || true
      ( cd "$(dirname "$COLLECTOR_COMPOSE")" && docker compose --env-file ../langfuse/.env down >/dev/null 2>&1 ) && echo "  ■ collector" || true
      ( cd "$(dirname "$OWUI_COMPOSE")" && docker compose --env-file .env down >/dev/null 2>&1 ) && echo "  ■ open-webui" || true
      ( cd "$(dirname "$LANGFUSE_COMPOSE")" && docker compose --env-file .env down >/dev/null 2>&1 ) && echo "  ■ langfuse" || true
      docker compose -f "$OBS_COMPOSE" down >/dev/null 2>&1 && echo "  ■ observability" || true
    fi
    ;;
  obs)   # bring up the heavy observability stack (otel-lgtm + Langfuse + collector) on demand
    ensure_obs
    echo "  observability up · Grafana → :3000 · Langfuse → :3002  (stop with: stack mon-down)"
    ;;
  llama-reload)
    systemctl --user is-active -q llama-swap \
      || { echo "  ⚠ llama-swap is not running" >&2; exit 1; }
    restart_llama_swap
    ;;
  canary)
    diagnostic_canary
    ;;
  restart)  # restart WHAT'S RUNNING, nothing else: inactive units stay inactive
    # units, so a gateway-only setup stays gateway-only and mcp/obs are never dragged in.
    any=0
    if systemctl --user is-active -q llama-swap; then
      restart_llama_swap
      any=1
    fi
    for u in litellm litellm-mcp; do
      if systemctl --user is-active -q "$u"; then
        systemctl --user try-restart "$u" && echo "  ↻ $u restarted" || echo "  ⚠ $u restart failed"
        any=1
      fi
    done
    [ "$any" = 1 ] || { echo "  • nothing running — start with: stack up"; exit 0; }
    ;;
  status)
    command -v llms >/dev/null && llms
    for u in llama-swap litellm litellm-mcp; do
      printf "  %-12s %s\n" "$u" "$(systemctl --user is-active "$u" 2>/dev/null || echo inactive) (systemd$(systemctl --user is-enabled -q "$u" 2>/dev/null && echo ', enabled at login'))"
    done
    for n in "glance:8088" "uptime-kuma:3009" "grafana:3000" "langfuse:3002" "collector:4318" "open-webui:8090"; do
      printf "  %-12s HTTP %s\n" "${n%%:*}" "$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 http://127.0.0.1:${n##*:}/ 2>/dev/null || echo down)"
    done
    printf "  %-12s %s\n" "rewrite" "$(curl -s --max-time 2 http://127.0.0.1:9292/running 2>/dev/null | grep -q rewrite && echo 'loaded (llama-swap)' || echo 'idle — llama-swap loads on demand')"
    ;;
  db-init)  # one-time per machine (or after a litellm upgrade): prisma client + LiteLLM_* tables.
            # LiteLLM virtual-key APIs need these. Install prep — ALL extras
            # the gateway needs (prisma=DB/keys, diskcache=exact response cache, opentelemetry=otel
            # tracing). Use the FULL line on every (re)install; `--force` drops anything omitted:
            #   uv tool install --force 'litellm[proxy-runtime,caching,extra_proxy]==1.97.0' \
            #     --with 'fastapi==0.136.3'
            #   stack db-init   # re-run after any --force reinstall (it wipes the generated prisma client)
    if [[ -z ${DATABASE_URL:-} && ${STACK_DB_INIT_INFISICAL:-0} != 1 ]]; then
      command -v infisical >/dev/null 2>&1 \
        || { echo "  ⚠ DATABASE_URL is unset and Infisical is unavailable"; exit 1; }
      export STACK_DB_INIT_INFISICAL=1
      exec infisical run --env "${INFISICAL_ENV:-dev}" --path "${INFISICAL_PATH:-/litellm}" -- "$0" db-init
    fi
    [[ -n ${DATABASE_URL:-} ]] \
      || { echo "  ⚠ Infisical did not provide DATABASE_URL for /litellm"; exit 1; }
    TB="$HOME/.local/share/uv/tools/litellm/bin"
    patch_litellm_prisma_client
    SCHEMA=$(find "$HOME/.local/share/uv/tools/litellm" -path '*proxy_extras*schema.prisma' 2>/dev/null | head -1)
    [ -n "$SCHEMA" ] || { echo "  ⚠ litellm prisma schema not found — run the pinned install command in ~/bin/llm-servers/litellm-gateway"; exit 1; }
    PATH="$TB:$PATH" "$TB/prisma" generate --schema "$SCHEMA" 2>&1 | tail -2 || true
    DATABASE_URL="${DATABASE_URL:-postgresql://litellm@127.0.0.1:5433/litellm}" \
      PATH="$TB:$PATH" "$TB/prisma" db push --schema "$SCHEMA" --skip-generate --accept-data-loss 2>&1 | tail -2
    echo "  ✓ prisma generated + LiteLLM_* tables ready — restart LiteLLM before using key APIs"
    ;;
  logs) journalctl --user -f -u litellm -u llama-swap -u litellm-mcp ;;  # systemd-owned now; old nohup logs remain in $RUN/*.log
  *) echo "usage: stack {up|gateway|preflight sift-chat|mcp [on|off]|dash|obs|down|mon-down|llama-reload|canary|restart|status|logs|db-init}"; exit 1 ;;
esac
